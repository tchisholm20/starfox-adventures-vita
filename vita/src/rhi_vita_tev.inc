               bad ? "NEVER compiled again (its programs are refused: CPU path / single-texture path)" : "compiled again when asked for");
    }
    if (g_ascs_off) { printf("[asc] crash sentinel OFF (asc_sentinel.txt 1): a compile that takes the process down leaves nothing behind, as in run 226\n"); return; }
    g_ascs_fd = sceIoOpen(TEV_DIR "ASC_COMPILING", SCE_O_RDWR | SCE_O_CREAT, 0777);
    g_ascs_cg = sceIoOpen(TEV_DIR "asc_compiling.cg", SCE_O_RDWR | SCE_O_CREAT, 0777);
