int rhi_vita_tev_timed;
unsigned long long rhi_vita_tev_flush_us, rhi_vita_tev_gldraw_us, rhi_vita_tev_lookup_us, rhi_vita_tev_batch_us;
unsigned rhi_vita_tev_flush_verts, rhi_vita_tev_memo_hits;
#define sceKernelGetProcessTimeWide() c3_clk()   /* GXAOT_HOOK C3 arm 106: tev_flush's four always-on reads (60 flushes a frame in normal play) AND rhi_vita_drawTev's four sampled reads (d0/d1); undone before the GPU vertex path. The span between holds only tev_skipped (no clock read) */
static void tev_flush(void)
{
    if (!g_tb.n) return;
    SceUInt64 f0 = sceKernelGetProcessTimeWide();
    const TevProg *p = &g_tevp[g_tb.prog];
    g_depth_apply = g_tb.depth;
    /* alpha TEST is the program's own compare (the key carries it): no fixed-function alpha test */
    vita_applyAlphaMode(g_tb.mode == RHI_ALPHA_TEST ? RHI_ALPHA_OPAQUE : g_tb.mode);
    glUseProgram(p->prog);
    for (int r = 0; r < 4; ++r) {
        glUniform4f(p->uM[r], g_tb.mvp[r * 4 + 0], g_tb.mvp[r * 4 + 1], g_tb.mvp[r * 4 + 2], g_tb.mvp[r * 4 + 3]);
        glUniform4f(p->uR[r], g_tb.u.reg[r][0], g_tb.u.reg[r][1], g_tb.u.reg[r][2], g_tb.u.reg[r][3]);
        glUniform4f(p->uK[r], g_tb.u.konst[r][0], g_tb.u.konst[r][1], g_tb.u.konst[r][2], g_tb.u.konst[r][3]);
    }
    glUniform2f(p->uAref, g_tb.u.acRef0, g_tb.u.acRef1);
    ind_upload(&p->key, p->uIM, p->uTS, &g_tb.u, g_tb.tsz);
    if (p->key.fogType) {   /* fog numbers (docs/47 run 116): uFog = (start, 1/(end-start)), colour in 0..1 */
        glUniform4f(p->uFog, g_tb.u.fogStart, g_tb.u.fogScale, 0.0f, 0.0f);
        glUniform4f(p->uFogColor, g_tb.u.fogColor[0] / 255.0f, g_tb.u.fogColor[1] / 255.0f, g_tb.u.fogColor[2] / 255.0f, 0.0f);
    }
    for (int t = 0; t < p->key.numTex; ++t) {
        glActiveTexture(GL_TEXTURE0 + t);
        glBindTexture(GL_TEXTURE_2D, g_tb.tex[t]);
    }
    const TevVertex *b = g_tb.buf;
    glEnableVertexAttribArray(0); glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof *b, &b->x);
    glEnableVertexAttribArray(1); glVertexAttribPointer(1, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof *b, &b->c0);
    glEnableVertexAttribArray(2); glVertexAttribPointer(2, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof *b, &b->c1);
    for (int t = 0; t < p->key.numTex; ++t) {
        glEnableVertexAttribArray((GLuint) (3 + t));
        glVertexAttribPointer((GLuint) (3 + t), 2, GL_FLOAT, GL_FALSE, sizeof *b, &b->t[t][0]);
    }
    SceUInt64 f1 = sceKernelGetProcessTimeWide();
    glDrawArrays(GL_TRIANGLES, 0, (GLsizei) g_tb.n);
    rhi_vita_tev_gldraw_us += sceKernelGetProcessTimeWide() - f1;
    for (int a = 0; a < 3 + p->key.numTex; ++a) glDisableVertexAttribArray((GLuint) a);
    glUseProgram(0);
    glActiveTexture(GL_TEXTURE0);
    gs_cur.backend_draws++; ++rhi_vita_tev_batches;
    rhi_vita_tev_flush_verts += g_tb.n;
    g_tb.n = 0;
    rhi_vita_tev_flush_us += sceKernelGetProcessTimeWide() - f0;
}

/* DIAGNOSTIC skip list (run 94: which draw is the blocky overlay?). ux0:data/stairfax/skip_tev.txt
 * holds lines of `<program hash, hex> <first present>`; a listed program draws nothing from that
 * present on, so ONE run carries both arms. Absent file = none. Read once and logged; the first
 * skip of each entry is logged, so a hash that never matched is visible as silence after the list. */
int rhi_vita_presents;
static int tev_skipped(uint32_t hash)
{
    static struct { uint32_t hash; int from, hit; } s_skip[8];
    static int s_n = -1;
    if (s_n < 0) {
        FILE *f = fopen("ux0:data/stairfax/skip_tev.txt", "r");
        unsigned h; int from;
        s_n = 0;
        if (f) { while (s_n < 8 && fscanf(f, "%x %d", &h, &from) == 2) { s_skip[s_n].hash = h; s_skip[s_n].from = from; s_n++; } fclose(f); }
        printf("[tevskip] %d listed\n", s_n);
        for (int i = 0; i < s_n; ++i) printf("[tevskip] %08x from present %d\n", (unsigned) s_skip[i].hash, s_skip[i].from);
    }
    for (int i = 0; i < s_n; ++i)
        if (s_skip[i].hash == hash && rhi_vita_presents >= s_skip[i].from) {
            if (!s_skip[i].hit) { s_skip[i].hit = 1; printf("[tevskip] %08x first skipped at present %d\n", (unsigned) hash, rhi_vita_presents); }
            return 1;
        }
    return 0;
}

/* B1-c2floor (docs/54 H1-pre (b)): the one-frame draw-stream dump.  Off unless perf_ab arm 114 is current (rhi_vita_gxdump.inc); -DSTFX_NO_GXDUMP removes the hooks. */
#ifdef STFX_NO_GXDUMP
#define g_gxd_on 0
#define gxd_cap_tev(...) ((void) 0)
#define gxd_cap_gx(...) ((void) 0)
#define gxd_event(...) ((void) 0)
#else
#include "gx_dump.h"
static void gxd_cap_tev(const TevKey *k, const TevUniforms *u, RhiTexture *const tex[TEVK_TEX], const TevVertex *verts, uint32_t count, const float mvp[16], int alphaMode, int pi);
#endif
/* 1: drawn (or batched) with a TEV program; 0: not -- the caller draws it its own way. */
int rhi_vita_drawTev(const TevKey *k, const TevUniforms *u, RhiTexture *const tex[TEVK_TEX],
                     const TevVertex *verts, uint32_t count, const float mvp[16], int alphaMode)
{
    if (GXSP_CAP()) return g_gxsp_api->drawTev(k, u, tex, verts, count, mvp, alphaMode);
    if (g_stfx_backend == STFX_BK_GXM) return rhi_gxm_drawTev(k, u, tex, verts, count, mvp, alphaMode);
    RT_SCOPE(RT_BACKEND);   /* Task 3 (rt_stats.txt): backend entry */
    if (g_tev_state < 0) tev_init();
    if (!g_tev_state) return 0;
    if (g_probe_arm && probe_skip(2, (alphaMode & 0xff) == RHI_ALPHA_BLEND || (alphaMode & 0xff) == RHI_ALPHA_ADD)) return 1;   /* the GPU probe: taken, not drawn */
    count -= count % 3u;
    if (!count) return 1;
    SceUInt64 d0 = rhi_vita_tev_timed ? sceKernelGetProcessTimeWide() : 0;
    /* The LAST key, remembered (run 103: the lookup was 38% of submit -- tev_hash walks the 408-byte
     * key a byte at a time for every primitive, and consecutive primitives nearly always share it).
     * ux0:data/stairfax/tev_nomemo.txt present = the old lookup every time, for the A/B. */
    static TevKey s_lk; static int s_memo = -1;   /* the remembered index is g_tev_memo: the budget forgets it when it destroys or recycles an entry */
    if (s_memo < 0) { FILE *mf = fopen("ux0:data/stairfax/tev_nomemo.txt", "r"); s_memo = mf ? 0 : 1; if (mf) fclose(mf); printf("[tev] last-key memo %s\n", s_memo ? "ON" : "OFF (tev_nomemo.txt)"); }
    int pi;
    if (s_memo && g_tev_memo != -2 && !memcmp(k, &s_lk, sizeof *k) && (g_tev_memo < 0 || g_tevp[g_tev_memo].ok)) {
        pi = g_tev_memo; ++rhi_vita_tev_memo_hits;
        if (pi >= 0) plru_touch(&g_plru, 0, pi, rhi_vita_presents);   /* in use this present: never a victim */
    }
    else { pi = tev_program(k); s_lk = *k; g_tev_memo = pi == -3 || pi == -4 ? -2 : pi; }   /* a pending program is not remembered: it is asked for again */
    if (rhi_vita_tev_timed) rhi_vita_tev_lookup_us += sceKernelGetProcessTimeWide() - d0;
    if (pi == -3) { ++rhi_vita_asc_skipped_draws; return 1; }   /* its program is being compiled off-thread: not drawn yet (run 171) */
/* GXAOT_HOOK_BEGIN C3 */
    if (rhi_vita_tev_timed) {   /* GXAOT_HOOK C3: the immediate batch census, on the prims gx_draw.c already samples (1 in 8): why this one does / does not join the open batch */
        GLuint c3i[TEVK_TEX] = {0}; for (int t = 0; t < k->numTex; ++t) if (tex[t]) c3i[t] = ((VitaTexture *) tex[t])->id;   /* GXAOT_HOOK C3 */
        if (pi >= 0) c3_imm_census(g_tb.n != 0, g_tb.prog != pi, g_tb.mode != alphaMode, g_tb.depth != g_depth, memcmp(g_tb.tex, c3i, sizeof c3i) != 0,   /* GXAOT_HOOK C3 */
                      memcmp(&g_tb.u, u, sizeof *u) != 0, memcmp(g_tb.mvp, mvp, sizeof g_tb.mvp) != 0);   /* GXAOT_HOOK C3 */
    }   /* GXAOT_HOOK C3 */
/* GXAOT_HOOK_END C3 */
    if (pi < 0) return 0;
    if (tev_skipped((uint32_t) g_tevp[pi].hash)) return 1;
    if (g_probe2_prog == pi) { ++rhi_vita_probe_skipped; return 1; }   /* GPU probe 2: this arm prices this program */
    if (__builtin_expect(g_gxd_on, 0)) gxd_cap_tev(k, u, tex, verts, count, mvp, alphaMode, pi);   /* B1-c2floor */
    GLuint ids[TEVK_TEX] = {0};
    SceUInt64 d1 = rhi_vita_tev_timed ? sceKernelGetProcessTimeWide() : 0, fl0 = rhi_vita_tev_flush_us;
    for (int t = 0; t < k->numTex; ++t) { if (!tex[t]) return 0; ids[t] = ((VitaTexture *) tex[t])->id; }
    int same = g_tb.n && g_tb.prog == pi && g_tb.mode == alphaMode && g_tb.depth == g_depth
            && !memcmp(g_tb.tex, ids, sizeof ids) && !memcmp(&g_tb.u, u, sizeof *u)
            && !memcmp(g_tb.mvp, mvp, sizeof g_tb.mvp);
    if (!same) {
        vita_flush();   /* the fixed-function batch and any other TEV batch land first: order is kept */
        g_tb.prog = pi; memcpy(g_tb.tex, ids, sizeof ids); memcpy(&g_tb.u, u, sizeof *u);   /* memcpy, not struct assignment: the batch compare above is memcmp over the padding too */ memcpy(g_tb.mvp, mvp, sizeof g_tb.mvp);
        g_tb.mode = alphaMode; g_tb.depth = g_depth;
        memset(g_tb.tsz, 0, sizeof g_tb.tsz);
        if (k->ik.on) for (int t = 0; t < k->numTex; ++t) { g_tb.tsz[t][0] = (float) ((VitaTexture *) tex[t])->w; g_tb.tsz[t][1] = (float) ((VitaTexture *) tex[t])->h; }
    }
    if (g_tb.n + count > g_tb.cap) {
        uint32_t cap = g_tb.cap ? g_tb.cap : 4096u;
        while (cap < g_tb.n + count) cap *= 2u;
        TevVertex *nb = (TevVertex *) realloc(g_tb.buf, cap * sizeof *nb);
        if (!nb) { tev_flush(); vtrace("tev_batch_oom", (int) count); return 1; }
        g_tb.buf = nb; g_tb.cap = cap;
    }
    memcpy(g_tb.buf + g_tb.n, verts, count * sizeof *verts);
    g_tb.n += count;
    /* compare + copy, less any flush this draw triggered (that is in flush_us, measured whole) */
    if (rhi_vita_tev_timed) rhi_vita_tev_batch_us += sceKernelGetProcessTimeWide() - d1 - (rhi_vita_tev_flush_us - fl0);
    ++rhi_vita_tev_draws;
    gs_cur.tex_calls++; gs_cur.tex_tris += count / 3u;
    {   float col[16]; for (int r = 0; r < 4; ++r) for (int c = 0; c < 4; ++c) col[c * 4 + r] = mvp[r * 4 + c];
        journal('V', &verts[0].x, sizeof verts[0], count, verts[0].c0, alphaMode, NULL, col);
        if (rhi_vita_journal) {   /* what the program samples, and how it combines (run 92: the blocky overlay) */
            printf("[draw]     tev %08x st %d ac %d/%d/%d ref %d/%d", (unsigned) g_tevp[pi].hash, k->numStages,
                   k->acComp0, k->acOp, k->acComp1, u->acRef0, u->acRef1);
            for (int t = 0; t < k->numTex; ++t) {
                const VitaTexture *vt = (const VitaTexture *) tex[t];
                float lo[2] = { 1e30f, 1e30f }, hi[2] = { -1e30f, -1e30f };
                for (uint32_t i = 0; i < count; ++i) for (int c = 0; c < 2; ++c) {
                    float x = verts[i].t[t][c]; if (x < lo[c]) lo[c] = x; if (x > hi[c]) hi[c] = x; }
                printf(" | t%d %dx%d f%u a0 %u uv [%.3g,%.3g]x[%.3g,%.3g]", t, vt->w, vt->h, (unsigned) vt->fmt, (unsigned) vt->a0,
                       lo[0], hi[0], lo[1], hi[1]);
            }
            printf("\n");
            /* run 126 (the cloud layer 35f320e3 is too bright): the uniforms of every journalled TEV draw,
             * and the program's whole key once -- the same fields stfx_oracle.py reads from retail. */
            printf("[draw]     tevu %08x reg", (unsigned) g_tevp[pi].hash);
            for (int r = 0; r < 4; ++r) printf(" %d,%d,%d,%d", u->reg[r][0], u->reg[r][1], u->reg[r][2], u->reg[r][3]);
            printf(" | k");
            for (int r = 0; r < 4; ++r) printf(" %u,%u,%u,%u", u->konst[r][0], u->konst[r][1], u->konst[r][2], u->konst[r][3]);
            printf(" | c0 %08x c1 %08x\n", (unsigned) verts[0].c0, (unsigned) verts[0].c1);
            if (!g_tevp[pi].dumped) {
                g_tevp[pi].dumped = 1;
                printf("[tevkey] %08x stages %d tex %d fog %d ac %d/%d/%d swap", (unsigned) g_tevp[pi].hash, k->numStages, k->numTex,
                       k->fogType, k->acComp0, k->acOp, k->acComp1);
                for (int t = 0; t < 4; ++t) printf(" %u%u%u%u", k->swap[t][0], k->swap[t][1], k->swap[t][2], k->swap[t][3]);
                printf("\n");
                for (int s = 0; s < k->numStages; ++s) {
                    const TevKeyStage *st = &k->st[s];
                    printf("[tevkey] %08x st%d tex %u ras %u cin %u,%u,%u,%u ain %u,%u,%u,%u cop %u,%u,%u,%u,%u aop %u,%u,%u,%u,%u swap %u/%u ksel %u/%u\n",
                           (unsigned) g_tevp[pi].hash, s, st->texSlot, st->ras, st->cin[0], st->cin[1], st->cin[2], st->cin[3],
                           st->ain[0], st->ain[1], st->ain[2], st->ain[3], st->cop[0], st->cop[1], st->cop[2], st->cop[3], st->cop[4],
                           st->aop[0], st->aop[1], st->aop[2], st->aop[3], st->aop[4], st->rasSwap, st->texSwap, st->kcsel, st->kasel);
                }
            }
        } }
    return 1;
}

#undef sceKernelGetProcessTimeWide   /* GXAOT_HOOK C3 arm 106 */
/* ==== THE GPU VERTEX PATH (2026-10-08, docs/47 fast path stage 2) ====================================
 * gx_draw.c (dlkCall) hands a cached display list here as a MESH -- the list's distinct vertices,
 * untransformed, in a static vertex buffer, with a u16 triangle list -- plus a VsKey / VsUniforms:
 * the transform, the per-vertex-indexed matrices, GX lighting and texgen run in a generated Cg VERTEX
 * program (hal/tev_gen.c tev_gen_vertex_gx), paired with the TEV key's fragment program. One program
 * per (VsKey, TevKey); run 131's census found 202 such pairs against 192 TEV keys.
 *
 * Every generated vertex body is compiled and run on the host against the CPU path first
 * (host/tests/build_vs_shader_test.sh: colour code for code, 0 mismatches). The device compile is
 * fenced by the same sentinel files as the TEV programs (TEV_COMPILING -> TEV_BAD), with the pair's
 * hash, so a pair that takes the process down is never compiled again and its draws stay on the CPU
 * path. What vitaGL + SceShaccCg can do here was measured first (vita-glprobe VSFAT, run 36): a
 * uniform array indexed by a vertex attribute, glUniform4fv with a count, glDrawElements from a
 * static element buffer. */
#define GXP_HASH 4096   /* GXP_MAX (1024) is at the top of this file, with the budget */
typedef struct {
    uint32_t hash, tevHash; VsKey vk; TevKey tk; GLuint prog; int ok; int pending, retryAt;
    int strikeLogged;   /* its refusal for a struck-out source has been printed and counted once */
    int cacheMiss;   /* the binary cache has been asked for this pair and had nothing (cleared when a build of it is saved) */
    GLint uM[4], uPos, uNrm, uMat, uAmb, uCL[5], uAL[5], uTM[TEVK_TEX], uPT[TEVK_TEX];
    GLint uBone;   /* R8 GPU skinning: the bone palette + scale row, -1 when the key is not skinned */
    GLint uTMX;   /* 2026-10-13: the texture-matrix palette (a slot whose matrix comes from the vertex's TEXnMTXIDX), -1 when the key has none */
    GLint uR[4], uK[4], uAref, uTex[TEVK_TEX], uFog, uFogColor;
    GLint uIM[3][2], uTS[TEVK_TEX];   /* indirect texturing (2026-10-12), as TevProg */
} GxProg;
static GxProg g_gxp[GXP_MAX];
static unsigned short g_gxp_ix[GXP_HASH];   /* open addressing: program index + 1, 0 = empty */
static int g_gxp_n;
#include "c3_cuts.inc"   /* GXAOT_HOOK C3 (patches/C3-perdraw/001): arms 100/101/106, the [c3] window line; needs g_gxp above */
#undef gStfxAb   /* R3a C0: end of the mapped region (AB_ARM below reads the REAL perf arm) */
/* the index over the pair table, rebuilt whole when the budget hands a slot out a second time (open addressing has no delete) */
static void gxp_reindex(void)
{
    memset(g_gxp_ix, 0, sizeof g_gxp_ix);
    for (int i = 0; i < g_gxp_n; ++i) {
        unsigned p = g_gxp[i].hash & (GXP_HASH - 1);
        while (g_gxp_ix[p]) p = (p + 1) & (GXP_HASH - 1);
        g_gxp_ix[p] = (unsigned short) (i + 1);
    }
}
/* The budget's destroy (prog_lru.h): the GL program of a LIVE entry goes, the entry and its key stay (the next draw with
 * it loads the binary again). Only ever an entry no draw has named for 8 presents (plru urgent_age), so neither the open
 * batch nor a scene in flight uses it; glDeleteProgram waits for the GPU (sceGxmFinish) before it frees anything. A
 * binary-loaded program's two private shader objects go with it (vitaGL marked them for deletion at the load). */
static void pl_destroy(void *user, int t, int i)
{
    (void) user;
    SceUInt64 t0 = sceKernelGetProcessTimeWide();
    if (t == 0) { TevProg *p = &g_tevp[i]; if (p->ok && p->prog) glDeleteProgram(p->prog); p->prog = 0; p->ok = 0; p->pending = 0; g_tev_memo = -2; }
    else        { GxProg *g = &g_gxp[i];  if (g->ok && g->prog) glDeleteProgram(g->prog); g->prog = 0; g->ok = 0; g->pending = 0; g_gxp_memo = -2; }
    if (t == 1) C3_SLOT_RESET(i);   /* GXAOT_HOOK C3: a destroyed pair program: every memo entry and shadowed uniform for the slot is dead */
    ++rhi_vita_prog_destroyed; rhi_vita_prog_destroy_us += sceKernelGetProcessTimeWide() - t0;
}
unsigned rhi_vita_gx_programs, rhi_vita_gx_link_fail, rhi_vita_gx_bad_skipped, rhi_vita_gx_refused, rhi_vita_gx_table_full,
         rhi_vita_gx_draws, rhi_vita_gx_meshes;
unsigned long long rhi_vita_gx_compile_us, rhi_vita_gx_draw_us, rhi_vita_gx_gldraw_us;   /* gldraw: glDrawElements alone, inside draw */

typedef struct { GLuint vbo, ibo; uint32_t nidx, vbytes; GxMeshLayout lay; } GxMesh;
unsigned long long rhi_vita_gx_mesh_bytes;   /* vertex + index bytes held by the meshes alive (vitaGL's pools) */

void *rhi_vita_gx_mesh_create(const void *verts, uint32_t vbytes, const uint16_t *idx, uint32_t nidx, const GxMeshLayout *lay)
{
    if (GXSP_CAP()) return g_gxsp_api->meshCreate(verts, vbytes, idx, nidx, lay);
    if (g_stfx_backend == STFX_BK_GXM) return rhi_gxm_gx_mesh_create(verts, vbytes, idx, nidx, lay);
    RT_SCOPE(RT_BACKEND);   /* Task 3 (rt_stats.txt): backend entry */
    GxMesh *m = (GxMesh *) malloc(sizeof *m);
    if (!m) return NULL;
    m->lay = *lay; m->nidx = nidx; m->vbytes = vbytes; m->vbo = m->ibo = 0;
    rhi_vita_gx_mesh_bytes += vbytes + nidx * 2u;
    glGenBuffers(1, &m->vbo); glGenBuffers(1, &m->ibo);
    glBindBuffer(GL_ARRAY_BUFFER, m->vbo);
    glBufferData(GL_ARRAY_BUFFER, (GLsizei) vbytes, verts, GL_STATIC_DRAW);
    glBindBuffer(GL_ARRAY_BUFFER, 0);
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m->ibo);
    glBufferData(GL_ELEMENT_ARRAY_BUFFER, (GLsizei) (nidx * 2u), idx, GL_STATIC_DRAW);
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
    ++rhi_vita_gx_meshes;
    return m;
}
/* New vertex bytes for a mesh whose indices stand (the morphed models, every frame). glBufferData, not glBufferSubData:
 * the buffer is re-specified, so a draw already queued keeps the old storage and vitaGL retires it itself. */
unsigned rhi_vita_gx_mesh_updates;
void rhi_vita_gx_mesh_update(void *mesh, const void *verts, uint32_t vbytes)
{
    if (GXSP_CAP()) { g_gxsp_api->meshUpdate(mesh, verts, vbytes); return; }
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_gx_mesh_update(mesh, verts, vbytes); return; }
    RT_SCOPE(RT_BACKEND);   /* Task 3 (rt_stats.txt): backend entry */
    GxMesh *m = (GxMesh *) mesh;
    if (!m) return;
    glBindBuffer(GL_ARRAY_BUFFER, m->vbo);
    glBufferData(GL_ARRAY_BUFFER, (GLsizei) vbytes, verts, GL_DYNAMIC_DRAW);
    rhi_vita_gx_mesh_bytes += vbytes; rhi_vita_gx_mesh_bytes -= m->vbytes; m->vbytes = vbytes;
    glBindBuffer(GL_ARRAY_BUFFER, 0);
    ++rhi_vita_gx_mesh_updates;
}
void rhi_vita_gx_mesh_destroy(void *mesh)
{
    if (GXSP_CAP()) { g_gxsp_api->meshDestroy(mesh); return; }
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_gx_mesh_destroy(mesh); return; }
    GxMesh *m = (GxMesh *) mesh;
    if (!m) return;
    vita_flush();   /* nothing queued may still name these buffers */
    glDeleteBuffers(1, &m->vbo); glDeleteBuffers(1, &m->ibo);
    rhi_vita_gx_mesh_bytes -= m->vbytes + m->nidx * 2u;
    free(m); --rhi_vita_gx_meshes;
}

/* ==== PERSPECTIVE-CORRECT PROJECTIVE TEXGEN (2026-10-12, docs/47 "persp") ====================================================
 * A GX_TG_MTX3x4 texgen (or any post matrix) was divided by q in the VERTEX program and the quotient interpolated across the triangle: a large water
 * triangle with a POS-projected reflection coordinate is then warped (affine, not perspective), and a vertex behind the eye (q <= 0) smears
 * its neighbours. Now the vertex program passes (s, t, q) un-divided for those slots (VsKey.projFrag) and the fragment program divides per pixel
 * (TevKey.projMask); the rasteriser interpolates (s, t, q) perspective-correctly, which is exactly what GX does. Both keys are made HERE from the
 * vertex key, so they cannot disagree. ux0:data/STFX00001/texgen_persp_off.txt starting with 1 = today's per-vertex divide (read once). The CPU path
 * (TevVertex carries two floats per slot) keeps the per-vertex divide. */
static int persp_on(void)
