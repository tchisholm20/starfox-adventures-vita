           rhi_vita_gx_compile_us / 1000.0, rhi_vita_gx_draws, rhi_vita_gx_draw_us / 1000.0, rhi_vita_gx_gldraw_us / 1000.0, rhi_vita_gx_meshes);
    /* programs built = the [gxp] / [tev] "programs" figures above (pair / TEV-only). Run 233 (arm OFF equivalent): 829 TEV hashes -> 187 shaders. keys aliased = raw TEV keys whose
       canonical form was already known (they share its program); distinct fragment sources = unique generated texts among the canonical keys that were built: if it is far
       below "canonical keys built" the canonicaliser still misses merges (add the field); equal = every merge that exists is taken. */
    printf("[dedupe] %s | raw TEV keys seen %u -> %d canonical (%u aliased to a program that already existed) | programs built: pair %u, TEV-only %u | fragment source texts built %u, distinct %d | tables full, answered with the raw key %u\n",
           g_td_state < 0 ? "not used yet" : g_td.on ? "ON" : "OFF (tev_dedupe_off.txt 1)", g_td.seen, g_td.ncan, g_td.aliased,
           rhi_vita_gx_programs, rhi_vita_tev_programs, g_td.src_total, g_td.nsrcs, g_td.over);
}
