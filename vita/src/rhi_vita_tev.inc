}
/* worker thread: around its compile. Two writes into files that are already open; a write that fails is counted, the compile goes on. */
static void ascs_arm(const AscJob *j)
{
    if (g_ascs_fd < 0) return;
    if (g_ascs_cg >= 0) {   /* the text first: when the sentinel names a source, its text is already there */
        char hd[64]; int n = snprintf(hd, sizeof hd, "// %s %08x %08x %u bytes\n", j->frag ? "fragment" : "vertex", (unsigned) j->h1, (unsigned) j->h2, (unsigned) j->len);
        sceIoLseek(g_ascs_cg, 0, SCE_SEEK_SET);
        if (sceIoWrite(g_ascs_cg, hd, (unsigned) n) != n || sceIoWrite(g_ascs_cg, j->src, j->len) != (int) j->len || sceIoWrite(g_ascs_cg, "\n//END\n", 7) != 7) ++rhi_vita_asc_sent_fail;
    }
    char b[32]; snprintf(b, sizeof b, "%08x %08x %08x %d\n", (unsigned) j->h1, (unsigned) j->h2, (unsigned) j->len, j->frag ? 1 : 0);
    sceIoLseek(g_ascs_fd, 0, SCE_SEEK_SET);
    if (sceIoWrite(g_ascs_fd, b, 29) != 29) ++rhi_vita_asc_sent_fail;
}
static void ascs_clear(void)
{
    if (g_ascs_fd < 0) return;
    sceIoLseek(g_ascs_fd, 0, SCE_SEEK_SET);
    if (sceIoWrite(g_ascs_fd, "00000000 00000000 00000000 0\n", 29) != 29) ++rhi_vita_asc_sent_fail;
}
static void asc_hash(const char *src, uint32_t *ph1, uint32_t *ph2, uint32_t *plen)
{
    uint32_t h1 = 2166136261u, h2 = 0x9E3779B9u, len = 0;
    for (const unsigned char *q = (const unsigned char *) src; *q; ++q, ++len) { h1 = (h1 ^ *q) * 16777619u; h2 = (h2 + *q) * 0x85EBCA6Bu; h2 ^= h2 >> 13; }
    *ph1 = h1; *ph2 = h2; *plen = len;
}
static int asc_thread(SceSize args, void *argp)
{
    (void) args; (void) argp;
    for (;;) {
        sceKernelWaitSema(g_asc_wake, 1, NULL);
        for (;;) {
            AscJob *j = NULL;
            for (int i = 0; i < ASC_MAX; ++i) if (g_asc[i].state == ASC_QUEUED && (!j || g_asc[i].seq < j->seq)) j = &g_asc[i];
            if (!j) break;
            while (g_asc_main_wants) sceKernelDelayThread(1000);
            sceKernelWaitSema(g_asc_sem, 1, NULL);                       /* the compiler is ours until the output is cleared */
            if (j->state != ASC_QUEUED || g_asc_main_wants) { sceKernelSignalSema(g_asc_sem, 1); sceKernelDelayThread(1000); continue; }
            j->state = ASC_COMPILING;
            SceUInt64 t0 = sceKernelGetProcessTimeWide();
            uint32_t sz = j->len;   /* IN: the length of the source; OUT: the size of the program (run 172 passed 0: an empty source, 48 of 48 failed in 0 ms) */
            ascs_arm(j);            /* run 226: if this compile takes the process down, the next boot knows which source it was */
            SceGxmProgram *p = __real_shark_compile_shader_extended(j->src, &sz, j->frag ? SHARK_FRAGMENT_SHADER : SHARK_VERTEX_SHADER,
                                                                    (shark_opt) compiler_opts, compiler_fastmath, compiler_fastprecision, compiler_fastint);
            ascs_clear();
            j->ms = (unsigned) ((sceKernelGetProcessTimeWide() - t0) / 1000);
            asc_stack_scan();       /* the deepest this stack has been, from the kernel's fill (not in j->ms's way: the state is set below) */
            if (p && sz) { j->out = p; j->size = sz; j->state = ASC_READY; }    /* output stays LIVE: the main thread picks it up and clears it */
            else { __real_shark_clear_output(); j->state = ASC_FAILED; sceKernelSignalSema(g_asc_sem, 1); }
        }
    }
    return 0;
}
static void asc_init(void)
{
    g_asc_on = 0;
    SceUID f = sceIoOpen(TEV_DIR "NOASYNC", SCE_O_RDONLY, 0777);
    if (f >= 0) { sceIoClose(f); printf("[asc] compiles off the main thread: OFF (NOASYNC marker)\n"); return; }
    ascs_init();   /* the strikes of earlier boots, and the sentinel's two files opened before the worker exists */
    g_asc_sem = sceKernelCreateSema("stfx_asc_c", 0, 1, 1, NULL);
    g_asc_wake = sceKernelCreateSema("stfx_asc_w", 0, 0, 1 << 20, NULL);
    g_asc_thr = sceKernelCreateThread("stfx_asc", asc_thread, 0x10000100, ASC_STACK_BYTES, 0, 0, NULL);   /* the default priority, as every other thread of the port: +32 was refused (run 171: 0x80028023 ILLEGAL_PRIORITY) */
    if (g_asc_sem < 0 || g_asc_wake < 0 || g_asc_thr < 0 || sceKernelStartThread(g_asc_thr, 0, NULL) < 0) {
        printf("[asc] compiles off the main thread: NOT started (sema %08x %08x thread %08x) -- main thread, as before\n", (unsigned) g_asc_sem, (unsigned) g_asc_wake, (unsigned) g_asc_thr);
        return;
    }
    g_asc_on = 1;
    { extern unsigned char start_shader_compiler(void); if (!is_shark_online) start_shader_compiler(); }   /* vitaGL starts it lazily, at its first compile: a boot that loads everything from the pack would never have */
    printf("[asc] compiles off the main thread: ON (worker thread %08x, 2 MB stack; compiler %s)\n", (unsigned) g_asc_thr, is_shark_online ? "online" : "NOT online: main thread until it is");
}
/* 1 = this source has a shader object, or must be compiled here and now (async off, compiler not started, or it failed on
   the worker: the main-thread compile then reports the failure the usual way). 0 = queued or in flight: come back later.
   -2 = it has killed the worker asc_strikes times: never compiled again, on either thread -- the caller gives the program up. */
static int asc_want(int frag, const char *src)
{
    if (g_asc_on < 0) asc_init();
    if (g_asc_on <= 0 && !g_ascs_bad_n) return 1;
    uint32_t h1, h2, len; asc_hash(src, &h1, &h2, &len);
    if (g_ascs_bad_n && ascs_is_bad(h1, h2, len)) return -2;
    if (g_asc_on <= 0 || !is_shark_online) return 1;
    const GLenum type = frag ? GL_CG_FRAGMENT_SHADER_EXT : GL_CG_VERTEX_SHADER_EXT;
    for (int i = 0; i < g_shobj_n; ++i) if (g_shobj[i].h1 == h1 && g_shobj[i].h2 == h2 && g_shobj[i].len == len && g_shobj[i].type == type) return 1;
    for (unsigned i = 0; i < g_asc_bad_n; ++i) if (g_asc_bad[i].h1 == h1 && g_asc_bad[i].h2 == h2 && g_asc_bad[i].len == len) return 1;
    AscJob *fr = NULL;
    for (int i = 0; i < ASC_MAX; ++i) {
        AscJob *j = &g_asc[i];
        if (j->state == ASC_FREE) { if (!fr) fr = j; continue; }
        if (j->h1 == h1 && j->h2 == h2 && j->len == len && j->frag == frag) return 0;   /* queued, compiling, ready or just failed: the tick settles it */
    }
    if (!fr) { ++rhi_vita_asc_queue_full; return 0; }
    char *cp = (char *) malloc(len + 1);
    if (!cp) return 1;
    memcpy(cp, src, len + 1);
    fr->h1 = h1; fr->h2 = h2; fr->len = len; fr->frag = frag; fr->src = cp; fr->out = NULL; fr->size = 0; fr->seq = ++g_asc_seq;
    fr->state = ASC_QUEUED; ++rhi_vita_asc_jobs;
    { unsigned d = 0; for (int i = 0; i < ASC_MAX; ++i) d += g_asc[i].state != ASC_FREE; if (d > rhi_vita_asc_depth_max) rhi_vita_asc_depth_max = d; }
    sceKernelSignalSema(g_asc_wake, 1);
    return 0;
}
static GLuint shobj(GLenum type, const char *src);
/* once a frame, on the GL thread: a finished compile becomes a shader object (which frees the compiler for the next job) */
void rhi_vita_asc_tick(void)
{
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_asc_tick(); return; }
    probe_tick(rhi_vita_presents);
    pl_tick();
    if (g_asc_on <= 0) return;
    for (int i = 0; i < ASC_MAX; ++i) {
        AscJob *j = &g_asc[i];
        if (j->state != ASC_READY) continue;
        g_asc_serving = j;
        const GLuint so = shobj(j->frag ? GL_CG_FRAGMENT_SHADER_EXT : GL_CG_VERTEX_SHADER_EXT, j->src);   /* -> glCompileShader -> the wrappers below */
        if (g_asc_serving) {   /* vitaGL did not come through the wrappers (it should have): release by hand, never hang */
            g_asc_serving = NULL; __real_shark_clear_output(); sceKernelSignalSema(g_asc_sem, 1); ++rhi_vita_asc_failed;
        }
        if (!so && g_asc_bad_n < 64) {   /* no shader handle for it (the budget): not queued again and again -- the main thread asks shobj itself, which refuses until there is room */
            g_asc_bad[g_asc_bad_n].h1 = j->h1; g_asc_bad[g_asc_bad_n].h2 = j->h2; g_asc_bad[g_asc_bad_n].len = j->len; ++g_asc_bad_n;
        }
        rhi_vita_asc_ms += j->ms; ++rhi_vita_asc_picked;
        printf("[asc] %s shader %08x (%u bytes of Cg) compiled off the main thread in %u ms\n", j->frag ? "fragment" : "vertex", (unsigned) j->h1, (unsigned) j->len, j->ms);
        free(j->src); j->src = NULL; j->state = ASC_FREE;
    }
    for (int i = 0; i < ASC_MAX; ++i) if (g_asc[i].state == ASC_FAILED && g_asc[i].src) {
        printf("[asc] %s shader %08x FAILED on the worker after %u ms: the main thread compiles it once more to report it\n", g_asc[i].frag ? "fragment" : "vertex", (unsigned) g_asc[i].h1, g_asc[i].ms);
        if (g_asc_bad_n < 64) { g_asc_bad[g_asc_bad_n].h1 = g_asc[i].h1; g_asc_bad[g_asc_bad_n].h2 = g_asc[i].h2; g_asc_bad[g_asc_bad_n].len = g_asc[i].len; ++g_asc_bad_n; }
        free(g_asc[i].src); g_asc[i].src = NULL; g_asc[i].state = ASC_FREE; ++rhi_vita_asc_failed;
        if (rhi_vita_asc_failed >= 8 && !rhi_vita_asc_picked) {   /* run 172: a worker that fails everything must not hold the game on the CPU path */
            g_asc_on = 0; printf("[asc] %u failures and nothing compiled: OFF for this boot, the main thread compiles as before\n", rhi_vita_asc_failed);
        }
    }
}
SceGxmProgram *__wrap_shark_compile_shader_extended(const char *src, uint32_t *size, shark_type type, shark_opt opt, int32_t fm, int32_t fp, int32_t fi)
{
    AscJob *j = g_asc_serving;
    if (j && j->state == ASC_READY && (type == SHARK_FRAGMENT_SHADER) == (j->frag != 0) && !strcmp(src, j->src)) {
        if (size) *size = j->size;
        return j->out;                         /* the worker's live output: nothing is compiled here */
    }
    if (g_asc_on > 0 && !g_asc_main_holds) {
        /* a compile of the main thread's own. A finished result nobody has picked up would hold the compiler for ever:
           drop it (re-queued); a compile in flight is waited for. */
        /* Run 173 DEADLOCKED here (present 899, copyGpu -> the EFB shader): the discard was done once, BEFORE the wait, the
           compile in flight finished DURING it, and the worker then held the compiler for a pickup only this thread could
           make. So: say the main thread wants the compiler (the worker stands back), and discard inside the wait loop. */
        SceUInt64 w0 = sceKernelGetProcessTimeWide();
        g_asc_main_wants = 1;
        for (;;) {
            for (int i = 0; i < ASC_MAX; ++i) if (g_asc[i].state == ASC_READY && &g_asc[i] != j) {
                __real_shark_clear_output(); g_asc[i].out = NULL; g_asc[i].state = ASC_QUEUED; ++rhi_vita_asc_discarded;
                sceKernelSignalSema(g_asc_sem, 1); sceKernelSignalSema(g_asc_wake, 1);
            }
            SceUInt to = 2000;   /* microseconds */
            if (sceKernelWaitSema(g_asc_sem, 1, &to) >= 0) break;
        }
        g_asc_main_wants = 0;
        if (sceKernelGetProcessTimeWide() - w0 > 2000) ++rhi_vita_asc_main_waits;
        g_asc_main_holds = 1;
    }
    return __real_shark_compile_shader_extended(src, size, type, opt, fm, fp, fi);
}
void __wrap_shark_clear_output(void)
{
    __real_shark_clear_output();
    if (g_asc_serving) { g_asc_serving = NULL; sceKernelSignalSema(g_asc_sem, 1); }
    else if (g_asc_main_holds) { g_asc_main_holds = 0; sceKernelSignalSema(g_asc_sem, 1); }
}
static GLuint shobj(GLenum type, const char *src)
{
    uint32_t h1 = 2166136261u, h2 = 0x9E3779B9u, len = 0;
    for (const unsigned char *q = (const unsigned char *) src; *q; ++q, ++len) { h1 = (h1 ^ *q) * 16777619u; h2 = (h2 + *q) * 0x85EBCA6Bu; h2 ^= h2 >> 13; }
    for (int i = 0; i < g_shobj_n; ++i)
        if (g_shobj[i].h1 == h1 && g_shobj[i].h2 == h2 && g_shobj[i].len == len && g_shobj[i].type == type) { ++rhi_vita_shobj_reuses; return g_shobj[i].id; }
    /* Run 224: a shader object past SHOBJ_MAX was created and never recorded (a handle lost at every use), and vitaGL's
       glCreateShader answers 0 on a full table and then writes shaders[-1]. Neither any more: 0 = no shader object. */
    if (g_pl_state < 0) pl_init();
    if (g_shobj_n >= SHOBJ_MAX || !plru_reserve(&g_plru, 0, 1, pl_sec_extra(), rhi_vita_presents)) { ++rhi_vita_shobj_refused; return 0; }
    SceUInt64 t0 = sceKernelGetProcessTimeWide();
    GLuint id = glCreateShader(type);
    if (id == 0 || id > PL_VGL_SHADERS) {
        ++rhi_vita_shobj_refused; ++rhi_vita_prog_handle_fail;
        printf("[plru] glCreateShader returned %08x with %d shader objects and %d program-owned shader handles: vitaGL is OUT OF SHADER HANDLES -- refused\n", (unsigned) id, g_shobj_n, g_plru.sec_used);
        pl_log_now();
        return 0;
    }
    glShaderSource(id, 1, &src, NULL); glCompileShader(id);
    rhi_vita_shobj_compile_us += sceKernelGetProcessTimeWide() - t0;
    ++rhi_vita_shobj_compiles;
    g_shobj[g_shobj_n].h1 = h1; g_shobj[g_shobj_n].h2 = h2; g_shobj[g_shobj_n].len = len; g_shobj[g_shobj_n].id = id; g_shobj[g_shobj_n].type = type; ++g_shobj_n;
    return id;
}
/* ---- INDIRECT TEXTURING uniforms (2026-10-12, tev_gen.c "INDIRECT TEXTURING"): the matrices ITM_0..2 as (row a, row b) float4s and, per texture slot an
 * indirect stage samples through, its size (w, h, 1/w, 1/h) in GX texels -- an EFB copy is its GX-declared size (VitaTexture w, h), not the render target's. */
static void ind_locs(GLuint pr, const TevKey *k, GLint im[3][2], GLint ts[TEVK_TEX])
{
    for (int m = 0; m < 3; ++m) im[m][0] = im[m][1] = -1;
    for (int t = 0; t < TEVK_TEX; ++t) ts[t] = -1;
    if (!k->ik.on) return;
    const unsigned mm = tev_ind_matrix_mask(k), tm = tev_ind_ts_mask(k);
    for (int m = 0; m < 3; ++m) if (mm >> m & 1) { char nm[12]; snprintf(nm, sizeof nm, "uIM%da", m); im[m][0] = glGetUniformLocation(pr, nm); snprintf(nm, sizeof nm, "uIM%db", m); im[m][1] = glGetUniformLocation(pr, nm); }
    for (int t = 0; t < TEVK_TEX; ++t) if (tm >> t & 1) { char nm[8]; snprintf(nm, sizeof nm, "uTS%d", t); ts[t] = glGetUniformLocation(pr, nm); }
}
static void ind_upload(const TevKey *k, const GLint im[3][2], const GLint ts[TEVK_TEX], const TevUniforms *u, const float sz[TEVK_TEX][2])
{
    if (!k->ik.on) return;
    for (int m = 0; m < 3; ++m) {
        if (im[m][0] >= 0) glUniform4f(im[m][0], u->indM[m][0][0], u->indM[m][0][1], u->indM[m][0][2], u->indE[m]);   /* .w = 2^exp: the dynamic (ITM_S/T) matrices use only that */
        if (im[m][1] >= 0) glUniform4f(im[m][1], u->indM[m][1][0], u->indM[m][1][1], u->indM[m][1][2], 0.0f);
    }
    for (int t = 0; t < TEVK_TEX; ++t) if (ts[t] >= 0 && sz[t][0] > 0.0f && sz[t][1] > 0.0f) glUniform4f(ts[t], sz[t][0], sz[t][1], 1.0f / sz[t][0], 1.0f / sz[t][1]);
}
static int tev_program(const TevKey *k_raw)
{
    /* Returns the table index of a program that is ALIVE, or: -1 no program for this key (for good: bad list, refused by the
       generator, link failed), -3 being compiled off-thread (the draw is skipped), -4 no room this present (table or budget:
       the draw falls back, the key is asked for again next present). `pending`: 1 = waiting for its shaders, 2 = waiting for room. */
    if (g_pl_state < 0) pl_init();
    td_ensure();
    /* the canonical key (and the variant, decided from the RAW key) -- everything below is the program's identity; the draw keeps its raw key */
    const TdCan *cn = td_lookup(k_raw);
    const TevKey *k = &cn->ck; const int fast = cn->fast;
    const uint32_t th = cn->th, h0 = th ^ (fast ? TEV_FAST_SALT : 0);   /* h0: the table / bad-list / sentinel / binary-cache hash, as the old h after its `h ^= SALT` */
    uint32_t h = h0;
    TevProg *p = NULL;
    for (int i = 0; i < g_tevp_n; ++i)
        if (g_tevp_hh[i] == h && !memcmp(&g_tevp[i].key, k, sizeof *k)) {
            plru_touch(&g_plru, 0, i, rhi_vita_presents);
            if (g_tevp[i].ok) return i;
            if (!g_tevp[i].pending && !plru_evicted(&g_plru, 0, i)) return -1;
            if (g_tevp[i].pending && g_tevp[i].retryAt == rhi_vita_presents) return g_tevp[i].pending == 2 ? -4 : -3;
            p = &g_tevp[i]; p->retryAt = rhi_vita_presents; break;   /* pending, or evicted by the budget: built again below */
        }
    if (!p) {
        int recycled; const int si = plru_slot(&g_plru, 0, rhi_vita_presents, &recycled);
        g_tevp_n = g_plru.n[0];
        if (si < 0) { ++rhi_vita_tev_table_full; return -4; }
        p = &g_tevp[si];
        memset(p, 0, sizeof *p);
        p->hash = th; p->key = *k; g_tevp_hh[si] = h;   /* hash: unsalted (tev_skipped, the logs); the table scans the salted one */
    }
    const int pi = (int) (p - g_tevp);
    for (int i = 0; i < g_tev_bad_n; ++i) if (g_tev_bad[i] == h) { ++rhi_vita_tev_bad_skipped; p->pending = 0; g_pl_tev[pi].evicted = 0; return -1; }
    static char vs[4096], fs[65536];
    if (tev_gen_vertex_ex(k->numTex, k->fogType, vs, sizeof vs) < 0 || (fast ? tev_gen_fragment_fast(k, fs, sizeof fs) : tev_gen_fragment(k, fs, sizeof fs)) < 0) { ++rhi_vita_tev_refused; p->pending = 0; g_pl_tev[pi].evicted = 0; return -1; }
    td_note_src(&g_td, fs);   /* distinct fragment texts among the canonical keys built: the [dedupe] line says how many merges were missed */
    /* the GL-program budget: room for one more, or this key waits a present (never a handle vitaGL does not have) */
    if (!pl_reserve()) { p->pending = 2; p->retryAt = rhi_vita_presents; return -4; }
    /* the program-binary cache (below, "shc"): a pair compiled on an earlier boot is LOADED, not compiled */
    SceUInt64 tc0 = sceKernelGetProcessTimeWide();
    GLint linked = 0; GLuint pr = p->cacheMiss ? 0 : shc_load(h, fast ? 'f' : 't', k, tev_key_len(k), NULL, 0);
    const int from_binary = pr != 0;
    if (pr) linked = 1; else {
    p->cacheMiss = 1;
    {   /* run 171: not on this thread. Both sources are queued at once (no short circuit); pending until both exist */
        const int av = asc_want(0, vs), af = asc_want(1, fs);
        if (av < 0 || af < 0) {   /* a source that has killed the worker twice (ASC_STRIKES): this program is given up for good -- the single-texture path */
            if (!p->strikeLogged) { p->strikeLogged = 1; ++rhi_vita_asc_bad_refused; printf("[tev] key %08x: its %s source is struck out (ASC_STRIKES) -- no program, single-texture path\n", (unsigned) h, av < 0 ? "vertex" : "fragment"); }
            p->pending = 0; g_pl_tev[pi].evicted = 0; return -1;
        }
        if (!av || !af) { if (p->pending != 1) ++rhi_vita_asc_deferred; p->pending = 1; p->retryAt = rhi_vita_presents; return -3; }
    }
    { char hl[64]; snprintf(hl, sizeof hl, "// key %08x\n", (unsigned) h); sent_arm(h, hl, vs, fs); }   /* the crash sentinel + the Cg dump (see sent_arm) */
    const char *vsp = vs, *fsp = fs;
    /* the Cg enums: vitaGL's GLSL path mangles Cg source (vita-renderer gbuffer_shader.c) */
    GLuint v = shobj(GL_CG_VERTEX_SHADER_EXT, vsp);     /* compiled once per distinct source, shared by every program that uses it */
    GLuint fr = shobj(GL_CG_FRAGMENT_SHADER_EXT, fsp);
    pr = v && fr ? pl_create_program() : 0;
    if (!pr) {   /* no handle (shader or program): NOT a link failure -- the key is not bad, it waits for room. Nothing is attached, bound or linked with a handle vitaGL did not give. */
        sent_clear(h);
        p->pending = 2; p->retryAt = rhi_vita_presents;
        return -4;
    }
    glAttachShader(pr, v); glAttachShader(pr, fr);
    glBindAttribLocation(pr, 0, "aPos"); glBindAttribLocation(pr, 1, "aColor0"); glBindAttribLocation(pr, 2, "aColor1");
    for (int t = 0; t < k->numTex; ++t) { char nm[8]; snprintf(nm, sizeof nm, "aT%d", t); glBindAttribLocation(pr, (GLuint) (3 + t), nm); }
    { const SceUInt64 l0 = sceKernelGetProcessTimeWide(); glLinkProgram(pr); rhi_vita_shc_link_us += sceKernelGetProcessTimeWide() - l0; ++rhi_vita_shc_new_n; }
    sent_clear(h);
    glGetProgramiv(pr, GL_LINK_STATUS, &linked);
    if (linked) { kg_add(h); shc_save(h, fast ? 'f' : 't', k, tev_key_len(k), NULL, 0, pr); p->cacheMiss = 0; if (fast) ++rhi_vita_tev_fast_programs; }
    }
    rhi_vita_tev_compile_us += sceKernelGetProcessTimeWide() - tc0;
    p->pending = 0;
    if (!linked) {
        ++rhi_vita_tev_compile_fail; tev_bad_add(h, 1);
        glDeleteProgram(pr); ++rhi_vita_prog_leak_fixed;   /* its handle goes back (it was kept for ever) */
        g_pl_tev[pi].evicted = 0;                          /* for good: not asked for again */
        printf("[tev] key %08x: link FAILED (%d stages, %d tex) -- bad for good, single-texture path\n", (unsigned) h, k->numStages, k->numTex);
        return -1;
    }
    p->prog = pr; p->ok = 1; ++rhi_vita_tev_programs;
    pl_commit(0, pi, from_binary ? 2 : 0);
    for (int r = 0; r < 4; ++r) {
        char nm[8];
        snprintf(nm, sizeof nm, "uM%d", r); p->uM[r] = glGetUniformLocation(pr, nm);
        snprintf(nm, sizeof nm, "uR%d", r); p->uR[r] = glGetUniformLocation(pr, nm);
        snprintf(nm, sizeof nm, "uK%d", r); p->uK[r] = glGetUniformLocation(pr, nm);
    }
    p->uAref = glGetUniformLocation(pr, "uAref");
    ind_locs(pr, k, p->uIM, p->uTS);
    p->uFog = p->uFogColor = -1;
    if (k->fogType) { p->uFog = glGetUniformLocation(pr, "uFog"); p->uFogColor = glGetUniformLocation(pr, "uFogColor"); }
    for (int t = 0; t < k->numTex; ++t) { char nm[8]; snprintf(nm, sizeof nm, "tex%d", t); p->uTex[t] = glGetUniformLocation(pr, nm); glUniform1i(p->uTex[t], t); }   /* the unit is kept in the program (docs/51): set once, not per draw */
    printf("[tev] key %08x: program %d built (%d stages, %d tex)\n", (unsigned) h, (int) (p - g_tevp), k->numStages, k->numTex);
    return (int) (p - g_tevp);
}

