        if (sscanf(b, "%x %x %x %d", &h1, &h2, &len, &frag) == 4 && len) {   /* all zero = nothing was in flight */
            SceUID s = sceIoOpen(TEV_DIR "ASC_STRIKES", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_APPEND, 0777);
