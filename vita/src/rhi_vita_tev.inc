/* ---- THE WORKER'S CRASH SENTINEL AND ITS STACK (2026-10-11, docs/47 "Run 226") -------------------------------------------
 * Run 226 died with the worker inside SceShaccCg (pc 0x8b1c7e5e, data abort) and nothing on the card said which source it
 * had: the TEV_COMPILING sentinel fences the main thread's LINK, the compile itself had none since run 171. Now the worker
 * writes "h1 h2 len frag" into ONE pre-opened file (ASC_COMPILING, rewritten in place: no create, no remove) before a
 * compile and zeroes it after, and the source text into asc_compiling.cg the same way (first line: whose it is; text after
 * the //END line is an older, longer source's tail). The next boot counts a STRIKE against that source (ASC_STRIKES).
 *
 * TWO strikes, not one (asc_strikes.txt = a number). Run 226's death was NOT the source's fault: the dump shows three stray
 * 0xFE bytes, 64 bytes apart, in the heap the compiler was using -- one in an operand record (the pointer it then followed),
 * one in a newlib chunk header -- and the source (4,694 bytes; a vertex shader of that length compiled in 1.5 s in run 224,
 * same generator) is shared by many pairs. One strike would have taken a good vertex shape off the GPU path for good. A
 * source that kills the worker twice is never compiled again, on either thread: its pair programs are refused (the list
 * goes by the CPU path, where the TEV-only program still draws it right if the bad source was the vertex one), its TEV-only
 * programs are refused (the single-texture path: counted, and it looks wrong).
 * ux0:data/stairfax/asc_sentinel.txt starting with 1 = no sentinel (the break arm: as run 226).
 *
 * THE STACK. Run 226's status line said "7848 KB never used of 2048": sceKernelGetThreadStackFreeSize is not a high-water
 * mark. The same dump shows what is: the kernel fills a thread's stack with 0xffffffff (word 0 at the base is its own
 * canary), and the worker's fill ended 85.9 KB under the top after 126 compiles (3.9 KB deep at the fault: not an overflow).
 * So the worker scans its own stack for the end of the fill after every compile. If the words just above the base are not
 * fill, or the kernel's idea of this thread's stack is not the 2 MB it was created with, the figure is UNKNOWN, not a guess. */
#define ASC_STACK_BYTES 0x200000
static volatile int g_asc_stack_used = -1;     /* bytes, the deepest the worker's stack has ever been; -1 no compile yet, -2 unknown */
static unsigned g_asc_stack_scans;
static const uint32_t *g_asc_stack_base; static unsigned g_asc_stack_mark;   /* worker only */
static void asc_stack_scan(void)
{
    if (g_asc_stack_used == -2) return;
    if (!g_asc_stack_base) {
        SceKernelThreadInfo ti; memset(&ti, 0, sizeof ti); ti.size = sizeof ti;
        volatile int here = 0;
        if (sceKernelGetThreadInfo(sceKernelGetThreadId(), &ti) < 0 || ti.stackSize != ASC_STACK_BYTES || !ti.stack
            || (uintptr_t) &here < (uintptr_t) ti.stack || (uintptr_t) &here >= (uintptr_t) ti.stack + ASC_STACK_BYTES) { g_asc_stack_used = -2; return; }
        g_asc_stack_base = (const uint32_t *) ti.stack; g_asc_stack_mark = ASC_STACK_BYTES / 4u;
        (void) here;
    }
    const uint32_t *w = g_asc_stack_base;
    for (unsigned i = 1; i <= 16; ++i) if (w[i] != 0xffffffffu) { g_asc_stack_used = -2; return; }
    unsigned i = 17;
    while (i < g_asc_stack_mark && w[i] == 0xffffffffu) ++i;   /* the mark only ever moves down: what is above it was used already */
    g_asc_stack_mark = i; g_asc_stack_used = (int) ((ASC_STACK_BYTES / 4u - i) * 4u); ++g_asc_stack_scans;
}
#define ASCS_MAX 64
static struct { uint32_t h1, h2, len; int frag, strikes; } g_ascs[ASCS_MAX]; static unsigned g_ascs_n, g_ascs_bad_n;
static int g_ascs_fd = -1, g_ascs_cg = -1, g_ascs_off, g_ascs_strikes_bad = 2;
unsigned rhi_vita_asc_bad_refused, rhi_vita_asc_sent_fail;
static void ascs_strike(uint32_t h1, uint32_t h2, uint32_t len, int frag)
{
    unsigned i = 0;
    for (; i < g_ascs_n; ++i) if (g_ascs[i].h1 == h1 && g_ascs[i].h2 == h2 && g_ascs[i].len == len) break;
    if (i == g_ascs_n) { if (g_ascs_n == ASCS_MAX) return; g_ascs[i].h1 = h1; g_ascs[i].h2 = h2; g_ascs[i].len = len; g_ascs[i].frag = frag; g_ascs[i].strikes = 0; ++g_ascs_n; }
    ++g_ascs[i].strikes;
}
/* 1 = this source has killed the worker often enough: it is never compiled again */
static int ascs_is_bad(uint32_t h1, uint32_t h2, uint32_t len)
{
    for (unsigned i = 0; i < g_ascs_n; ++i) if (g_ascs[i].h1 == h1 && g_ascs[i].h2 == h2 && g_ascs[i].len == len) return g_ascs[i].strikes >= g_ascs_strikes_bad;
    return 0;
}
