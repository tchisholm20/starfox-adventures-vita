/* rhi_vita_tev.inc -- included at the END of rhi_vita.c (it uses that file's statics: vita_flush,
 * vita_applyAlphaMode, g_depth, g_depth_apply, journal, vtrace, gs_cur, VitaTexture).
 *
 * ==== TEV PROGRAMS (docs/47, 2026-09-28) ==========================================================
 * gx_draw hands a draw whose TEV state it could key (hal/gx_tev.c gx_tev_build) here, with up to
 * TEVK_TEX textures and per-vertex texcoords. One Cg program per distinct key, generated by
 * hal/tev_gen.c. Every generated body was compiled AND run on the host against the exact integer
 * reference (host/tests/build_tev_shader_test.sh: bit-exact over the device's census keys and 400
 * random keys; the reference cross-checked against the THP conversion).
 *
 * The device still compiles at runtime (there is no host Cg compiler on this machine; docs/42 s8.3
 * assumed one), so every compile is fenced by a CRASH SENTINEL, the vita-renderer's pattern: the
 * key's hash is written to TEV_COMPILING before the compile and removed after it. A compile that
 * takes the process down leaves the file behind; the next boot moves that hash to TEV_BAD, and a
 * key in TEV_BAD is never compiled again -- its draws take the single-texture path, COUNTED.
 * Kill switch: ux0:data/STFX00001/NOTEV disables the path (the whole A/B in one marker). */
#include "port/gx_tev_key.h"
/* rhi_gxm.c (milestone M1): the same dispatch rule as rhi_vita.c, first statement of each entry point */
int rhi_gxm_drawTev(const TevKey *k, const TevUniforms *u, RhiTexture *const tex[TEVK_TEX], const TevVertex *verts, uint32_t count, const float mvp[16], int alphaMode);
void *rhi_gxm_gx_mesh_create(const void *verts, uint32_t vbytes, const uint16_t *idx, uint32_t nidx, const GxMeshLayout *lay);
void rhi_gxm_gx_mesh_update(void *mesh, const void *verts, uint32_t vbytes);
void rhi_gxm_gx_mesh_destroy(void *mesh);
int rhi_gxm_drawTevGx(const TevKey *tk, const TevUniforms *u, RhiTexture *const tex[TEVK_TEX], const VsKey *vk, const VsUniforms *vu, void *mesh, int alphaMode);
void rhi_gxm_asc_tick(void); void rhi_gxm_shc_flush(unsigned ms); void rhi_gxm_shc_shutdown(void); void rhi_gxm_gx_report(void);

#define TEV_DIR "ux0:data/STFX00001/"
#define TEVP_MAX 512    /* 256 until run 224, which filled it (196 programs + 60 entries left pending); a full table now recycles its oldest entry */
#define GXP_MAX 1024    /* 512 until run 150, which reached 339 pairs by the bird cutscene; run 224 reached 868: a full table now recycles its oldest entry */
typedef struct {
    uint32_t hash; TevKey key; GLuint prog; int ok; int pending, retryAt; int dumped;   /* dumped: key printed in a journal frame (run 126) */
    int strikeLogged;   /* its refusal for a struck-out source has been printed and counted once */
    int cacheMiss;   /* the binary cache has been asked for this key and had nothing (cleared when a build of it is saved) */
    GLint uM[4], uR[4], uK[4], uAref, uTex[TEVK_TEX];
    GLint uIM[3][2], uTS[TEVK_TEX];   /* indirect texturing (2026-10-12): matrices ITM_0..2 rows, texture sizes; -1 when the key does not declare them */
    GLint uFog, uFogColor;   /* fog (docs/47 run 116): -1 unless the key has fogType */
} TevProg;
static TevProg g_tevp[TEVP_MAX];
static uint32_t g_tevp_hh[TEVP_MAX];   /* the hashes alone, packed: the lookup scans these 2 KB, not 512 entries of 500+ bytes */
static int g_tevp_n, g_tev_state = -1;   /* -1: not initialised, 0: off, 1: on */

/* ==== THE GL-PROGRAM BUDGET (2026-10-11, docs/47 "Run 224") =========================================================
 * Run 224 crashed in the Krazoa Palace landing cutscene with 1,008 GL programs alive and about one new one per present.
 * The installed vitaGL keeps programs in a fixed progs[1024] and shaders in shaders[2048], is built without error
 * handling, and on a full table hands back 0xFFFFFFFF (programs; read out of the installed library's code) or 0
 * (shaders) and then indexes with it. Nothing here ever deleted a program. prog_lru.h is the bookkeeping (host-tested:
 * host/tests/build_prog_lru_test.sh); this is the device side: the budget, the destroy, the knobs, the telemetry.
 *   ux0:data/stairfax/prog_evict.txt starting with 1 = the OLD tables: nothing is evicted, no slot is recycled. The
 *       budget still REFUSES at its cap (counted, the draw falls back) -- the old behaviour past it was a wild write.
 *   ux0:data/stairfax/prog_cap.txt = a number: the budget of live programs (default 896). A small one (200) exercises
 *       eviction in the first minutes; one over 1022 lets vitaGL's own wall be reached, where pl_create_program
 *       reports the handle it was given and refuses instead of using it.
 *   ux0:data/stairfax/prog_idle.txt = a number: presents a program must be idle before the per-present trim takes it
 *       (default 1800). */
#include "prog_lru.h"
#include "tev_dedupe.h"   /* one GL program per distinct fragment program TEXT (docs/47 "Run 233"); host-tested: host/tests/build_tev_canon_test.sh */
#include <malloc.h>   /* mallinfo */
extern int rhi_vita_presents;   /* defined below: the frame number */
#define PL_VGL_PROGS   1024   /* vitaGL custom_shaders.c MAX_CUSTOM_PROGRAMS */
#define PL_VGL_SHADERS 2048   /* vitaGL custom_shaders.c MAX_CUSTOM_SHADERS */
#define PL_OUTSIDE_PROGS 8    /* programs not in the tables: the two EFB programs, and room */
#define PL_OUTSIDE_SHADERS 16 /* shader objects not counted by g_shobj_n: the EFB programs' four, and room */
static Plru g_plru; static PlruEnt g_pl_tev[TEVP_MAX], g_pl_gx[GXP_MAX];
static int g_pl_state = -1, g_tev_memo = -2, g_gxp_memo = -2;   /* the memos: the index of the last key looked up, -2 = none */
unsigned rhi_vita_prog_handle_fail, rhi_vita_prog_destroyed, rhi_vita_shobj_refused, rhi_vita_prog_leak_fixed;
unsigned long long rhi_vita_prog_destroy_us;
static void pl_destroy(void *user, int t, int i);
static int pl_sec_extra(void);
static void pl_log_now(void) { extern void vt_log_flush(void) __attribute__((weak)); if (vt_log_flush) vt_log_flush(); }   /* a line that must reach the card before anything else happens */
static int pl_file_int(const char *path, int dflt)
{
    FILE *f = fopen(path, "r"); int v = dflt;
    if (f) { if (fscanf(f, "%d", &v) != 1) v = dflt; fclose(f); }
    return v;
}
static void pl_init(void)
{
    const int off = pl_file_int("ux0:data/stairfax/prog_evict.txt", 0) == 1;
    int cap = pl_file_int("ux0:data/stairfax/prog_cap.txt", 896), idle = pl_file_int("ux0:data/stairfax/prog_idle.txt", 1800);
    if (cap < 16) cap = 16;
    if (idle < 8) idle = 8;
    /* THE TRIM (run 226). It started at 3/4 of the budget (672 of 896) and took 4 programs a present: 422 evictions at 5.5 ms
     * each (2.3 s of glDeleteProgram) and 26 reloads in one ordinary session whose peak was 692 -- 204 handles short of the
     * budget. Nothing needed those handles. What the trim WAS doing by accident is holding the shader patcher's vertex USSE
     * area down (898 of 1024 KB at 672 live, [mem] LOW at present 6840), and that is a different resource with its own
     * signal. So: the count-driven trim starts 64 under the budget (prog_trim.txt = a number: the mark itself; 672 = run
     * 226's), takes ONE program a present and none after a present that built a program (prog_lru.h plru_tick); the patcher
     * areas are doubled where it filled (rhi_vita.c, patcher_small.txt) and their fill is the trim's second trigger
     * (pl_tick: over 3/4 -> one owner of shader objects a present). */
    int soft = pl_file_int("ux0:data/stairfax/prog_trim.txt", cap - 64);
    if (soft > cap) soft = cap;
    if (soft < 8) soft = 8;
    plru_init(&g_plru, cap, soft, PL_VGL_SHADERS - PL_OUTSIDE_SHADERS, PL_VGL_SHADERS - PL_OUTSIDE_SHADERS - 128, idle, 8, !off, pl_destroy, NULL);
    plru_add_table(&g_plru, g_pl_tev, TEVP_MAX); plru_add_table(&g_plru, g_pl_gx, GXP_MAX);
    g_pl_state = 1;
    printf("[plru] GL-program budget: %d live (vitaGL holds %d; %d kept for programs outside the tables), trim from %d, one a present; shader handles %d of %d (trim from %d); eviction %s; idle %d presents; tables %d TEV + %d pair slots\n",
           cap, PL_VGL_PROGS, PL_OUTSIDE_PROGS, g_plru.soft, g_plru.sec_cap, PL_VGL_SHADERS, g_plru.sec_soft, off ? "OFF (prog_evict.txt 1): the budget only refuses" : "on", idle, TEVP_MAX, GXP_MAX);
    if (cap > PL_VGL_PROGS - PL_OUTSIDE_PROGS) printf("[plru] prog_cap.txt %d is past vitaGL's own table: only the check of glCreateProgram's result stands between this run and a wild write\n", cap);
}
/* glCreateProgram, with the check vitaGL does not make. 0 = no handle: NOTHING may be done with it. */
static GLuint pl_create_program(void)
{
    GLuint pr = glCreateProgram();
    if (pr == 0 || pr > PL_VGL_PROGS) {
        ++rhi_vita_prog_handle_fail;
        printf("[plru] glCreateProgram returned %08x with %d programs live in the tables (peak %d): vitaGL is OUT OF PROGRAM HANDLES -- refused, the draw falls back (event %u)\n",
               (unsigned) pr, g_plru.live, g_plru.peak, rhi_vita_prog_handle_fail);
        pl_log_now();
        return 0;
    }
    return pr;
}
/* room for one more program (which may own two shader handles)? 0 = refused: do not create */
static int pl_reserve(void)
{
    if (g_pl_state < 0) pl_init();
    return plru_reserve(&g_plru, 1, 2, pl_sec_extra(), rhi_vita_presents);
}
static void pl_mem_line(const char *why);
/* the entry (table t, slot i) now owns `pr`; sec = 2 when it was linked from a binary (two private shader objects) */
static void pl_commit(int t, int i, int sec)
{
    plru_commit(&g_plru, t, i, sec, rhi_vita_presents);
    if (g_plru.commits % 50 == 0) { char w[48]; snprintf(w, sizeof w, "program build %u", g_plru.commits); pl_mem_line(w); }
}
static uint32_t g_tev_bad[512]; static int g_tev_bad_n;
unsigned rhi_vita_tev_programs, rhi_vita_tev_compile_fail, rhi_vita_tev_bad_skipped, rhi_vita_tev_refused,
         rhi_vita_tev_table_full, rhi_vita_tev_draws, rhi_vita_tev_batches;

static uint32_t __attribute__((unused)) tev_hash(const TevKey *k) { return td_hash(k); }   /* (the body moved to tev_dedupe.h, unchanged) */
/* ==== ONE PROGRAM PER PROGRAM TEXT (2026-10-12, docs/47 "Run 233") ====================================================
 * Run 233: 1,091 pair programs over 829 TEV key hashes, but only 125 distinct fragment sources (the shader objects were already
 * shared by source text; only the PROGRAM was per key). 832 live against vitaGL's 1,024, 576 evictions at ~5 ms of glDeleteProgram
 * each (2.9 s), 819 binaries written. The tables below are now keyed by the CANONICAL key (tev_gen.c tev_key_canon: every field the
 * generator never reads zeroed or renumbered), looked up through g_td (tev_dedupe.h). Draws still pass their own RAW key's uniforms.
 *   ux0:data/STFX00001/tev_dedupe_off.txt starting with 1 = the break arm: canonical key == raw key, today's behaviour (read once).
 * On-disc cache: shc_load / shc_save take (hash, key bytes) of the CANONICAL key, so equal-text keys share one file. Binaries saved
 * under a raw key that is not its own canonical form are not found by the new hashes (compiled once more, saved under the new one). */
static Td g_td; static int g_td_state = -1;
/* the canonical record for a raw key; a full table (TD_CAN canonical records / TD_RAW raw keys) answers with the RAW key -- today's identity for it -- and says so */
static int tev_fast_on(void);
static const TdCan *td_lookup(const TevKey *raw)
{
    const unsigned o = g_td.over;
    const TdCan *c = td_get(&g_td, raw, tev_fast_on());
    if (g_td.over != o && (g_td.over <= 3 || !(g_td.over & 1023)))
        printf("[dedupe] table FULL (%d canonical records of %d, %d raw keys of %d): a key is answered with its RAW key (overflow %u, counted in the status line)\n", g_td.ncan, TD_CAN, g_td.nraw, TD_RAW, g_td.over);
    return c;
}
static void td_ensure(void)
{
    if (g_td_state >= 0) return;
    SceUID f = sceIoOpen(TEV_DIR "tev_dedupe_off.txt", SCE_O_RDONLY, 0777); char c = 0;
    if (f >= 0) { sceIoRead(f, &c, 1); sceIoClose(f); }
    g_td.on = c != 49; g_td_state = 1;
    printf("[dedupe] %s\n", g_td.on ? "ON (default): one program per distinct canonical TEV key; tev_dedupe_off.txt starting with 1 turns it off" : "OFF (tev_dedupe_off.txt 1): canonical key == raw key, one program per raw key");
}
static void tev_bad_add(uint32_t h, int persist)
{
    if (g_tev_bad_n < (int) (sizeof g_tev_bad / sizeof g_tev_bad[0])) g_tev_bad[g_tev_bad_n++] = h;
    if (!persist) return;
    SceUID f = sceIoOpen(TEV_DIR "TEV_BAD", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_APPEND, 0777);
    if (f >= 0) { char b[16]; int n = snprintf(b, sizeof b, "%08x\n", (unsigned) h); sceIoWrite(f, b, (unsigned) n); sceIoClose(f); }
}
static void tev_init(void)
{
    SceUID f = sceIoOpen(TEV_DIR "NOTEV", SCE_O_RDONLY, 0777);
    if (f >= 0) { sceIoClose(f); g_tev_state = 0; printf("[tev] TEV programs OFF (NOTEV marker)\n"); return; }
    g_tev_state = 1;
    /* a compile that never returned: its key becomes bad for good */
    f = sceIoOpen(TEV_DIR "TEV_COMPILING", SCE_O_RDONLY, 0777);
    if (f >= 0) {
        char b[16] = {0}; sceIoRead(f, b, sizeof b - 1); sceIoClose(f);
        uint32_t h = (uint32_t) strtoul(b, NULL, 16);
        sceIoRemove(TEV_DIR "TEV_COMPILING");
        if (h) {   /* 0 = "00000000": nothing was in flight (the in-place sentinel's idle value) */
        tev_bad_add(h, 1);
        printf("[tev] the previous boot died compiling key %08x: marked bad\n", (unsigned) h);
        /* tev_compiling.cg is written by the background writer and may be an EARLIER program's: its first line says whose */
        SceUID cg = sceIoOpen(TEV_DIR "tev_compiling.cg", SCE_O_RDONLY, 0777);
        if (cg >= 0) { char l[48] = {0}; sceIoRead(cg, l, sizeof l - 1); sceIoClose(cg); char *nl = strchr(l, 10); if (nl) *nl = 0;
                       printf("[tev] tev_compiling.cg says: %s%s\n", l, strstr(l, b) ? " (the same key)" : " (NOT this key: the dump of the crashing program did not reach the card)"); }
        }
    }
    f = sceIoOpen(TEV_DIR "TEV_BAD", SCE_O_RDONLY, 0777);
    if (f >= 0) {
        char b[4096]; int n = sceIoRead(f, b, sizeof b - 1); sceIoClose(f);
        if (n > 0) {
            b[n] = 0;
            char *p = b;
            while (*p) {
                char *e; uint32_t h = (uint32_t) strtoul(p, &e, 16);
                if (e == p) break;
                if (h) tev_bad_add(h, 0);
                p = e; while (*p == '\n' || *p == '\r' || *p == ' ') ++p;
            }
        }
    }
    printf("[tev] TEV programs ON; %d key(s) on the bad list\n", g_tev_bad_n);
}
/* ==== PROGRAM-BINARY CACHE "shc" (2026-10-08, docs/47 "Runs 133-134") ================================
 * Run 134: 162 (vertex, TEV) pair programs took 619 s to compile, 3.8 s each, at first use, mid-frame
 * (a TEV-only program: 1.3 s). The installed vitaGL has no shader cache of its own, but it can
 * serialise a linked program (glGetProgramBinary: the bound attributes + both compiled shaders) and
 * link one from that (glProgramBinary: no SceShaccCg). So every program that links is written to
 * ux0:data/STFX00001/shc/<kind><hash>.bin with its whole KEY in the header, and a later boot loads it.
 * A file whose magic, generator version or key bytes differ is ignored (and overwritten by the fresh
 * compile). A load is fenced like a compile: SHC_LOADING names the file before glProgramBinary and is
 * removed after; a boot that finds it deletes that file. Kill switch: ux0:data/STFX00001/NOSHC. */
#include <psp2/io/stat.h>   /* sceIoMkdir */
#include <psp2/io/dirent.h> /* the one-time fold of per-program files into the pack */
#define SHC_DIR TEV_DIR "shc/"
#define SHC_MAGIC 0x31434853u   /* "SHC1" */
#define SHC_VERSION ((uint32_t) TEVGEN_VERSION << 8 | 1u)   /* bump the low byte when tev_gen_vertex_gx's output changes */
static int g_shc = -1;
static int g_shc_bypass;   /* TEV_DIR "shc_bypass.txt" starting with 1: this boot loads and saves NOTHING (every program is compiled: the test arm for the off-thread compiles) */
static uint32_t g_shc_buf[65536];   /* 256 KB, word-aligned: vitaGL reads the binary through uint32 pointers */
unsigned rhi_vita_shc_loaded, rhi_vita_shc_saved, rhi_vita_shc_stale, rhi_vita_shc_load_fail, rhi_vita_shc_save_fail;
unsigned long long rhi_vita_shc_load_us, rhi_vita_shc_save_us;   /* save_us: the SYNCHRONOUS save only (shc_sync.txt 1); the background save's cost is split below */

/* ==== THE BACKGROUND SAVE AND THE CHEAP SENTINEL (2026-10-11, docs/47 "Run 224" follow-up) ============================
 * Run 224's log: every first-time program cost ~550 ms on the main thread, and 357-485 ms of it was shc_save -- 211 saves =
 * 86.6 s of the 92.7 s "compile" total. What the old save did per new program (all INFERRED from the code: only the total was
 * measured): glGetProgramiv + glGetProgramBinary into g_shc_buf, then ONE sceIoOpen(O_CREAT|O_TRUNC) of a NEW file in a
 * directory holding 1,100+ of them, one sceIoWrite of ~3 KB, one sceIoClose. It did NOT touch the pack (the pack is only
 * appended by shc_load). So ~400 ms is one file CREATE + CLOSE on the SD2VITA FAT volume (directory growth + metadata), not
 * the data. Around the link the main thread also did two more creates (TEV_COMPILING, tev_compiling.cg with the whole Cg
 * source) and a remove. Build after run 224 prints the split: this block replaces both.
 *   - The binary is copied into a malloc'd image that a QUEUE owns (shc_queue.h, host-tested); a writer thread writes it to
 *     a temp name and renames it onto <kind><hash>.bin -- the same file shc_load has always read. Main never waits on the card.
 *   - ux0:data/stairfax/shc_sync.txt: first char '1' = TODAY'S synchronous save and sentinels (the break arm); '2' = the
 *     background save and a sentinel that is also sceIoSyncByFd'd after every write; anything else = background save and
 *     the cheap sentinel (one pre-opened file rewritten in place, no sync). */
#include "shc_queue.h"
#include <psp2/kernel/threadmgr.h>
#include <psp2/io/fcntl.h>
static void shc_path(char *out, size_t cap, uint32_t h, char kind);
static Sq g_sq;
static int g_shw_mode = -1;                         /* -1 unread, 0 synchronous (today), 1 background, 2 background + synced sentinel */
static int g_shw_on, g_shw_failed;                  /* the writer thread runs / could not be started (then saves are synchronous) */
static SceUID g_shw_wake = -1, g_shw_thr = -1;
static volatile int g_shw_stop, g_shw_abandon, g_shw_stopped;
#define SHW_MAX_BYTES (4u << 20)                    /* images held by the queue at once; past it a save is DROPPED and counted */
static struct { volatile int state; char *buf; unsigned len; } g_diag;   /* the Cg-source dump: 0 free, 1 queued (writer owns), 3 written (main frees) */
unsigned long long rhi_vita_shc_link_us, rhi_vita_shc_get_us, rhi_vita_shc_enq_us, rhi_vita_sent_arm_us, rhi_vita_sent_clr_us, rhi_vita_shc_qload_us;
unsigned rhi_vita_shc_new_n, rhi_vita_sent_skipped, rhi_vita_sent_fail, rhi_vita_diag_queued, rhi_vita_diag_skipped;
static int shc_bg(void)
{
    if (g_shw_mode < 0) {
        int v = 1; { FILE *f = fopen("ux0:data/stairfax/shc_sync.txt", "r"); if (f) { int c = fgetc(f); fclose(f); v = c == 49 ? 0 : c == 50 ? 2 : 1; } }
        g_shw_mode = v; sq_init(&g_sq, SHW_MAX_BYTES);
        printf("[shc] saves: %s (shc_sync.txt); queue holds at most %d images / %u KB\n",
               v == 0 ? "SYNCHRONOUS on the main thread, sentinels as before (the break arm)" : v == 2 ? "background writer, sentinel synced after every write" : "background writer, cheap sentinel",
               SQ_SLOTS, SHW_MAX_BYTES / 1024u);
    }
    return g_shw_mode >= 1;
}
static int shw_open(void *u, const char *p) { (void) u; return sceIoOpen(p, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777); }
static int shw_write(void *u, int fd, const void *p, unsigned n) { (void) u; return sceIoWrite(fd, p, n); }
static int shw_close(void *u, int fd) { (void) u; return sceIoClose(fd); }
static int shw_rename(void *u, const char *a, const char *b) { (void) u; return sceIoRename(a, b); }
static int shw_remove(void *u, const char *p) { (void) u; return sceIoRemove(p); }
static void shc_pk_append(uint32_t h, char kind, const uint32_t *img, unsigned len);
static int g_pk_on, g_pk_folded; extern unsigned rhi_vita_shc_pack_appended;
static int shw_thread(SceSize args, void *argp)
{
    (void) args; (void) argp;
    const ShcIo io = { NULL, shw_open, shw_write, shw_close, shw_rename, shw_remove };
    for (;;) {
        sceKernelWaitSema(g_shw_wake, 1, NULL);
        for (;;) {
            if (g_diag.state == 1) {   /* the diagnostic dump goes before any save: it is the one that matters if the next link kills the process */
                SceUID f = sceIoOpen(TEV_DIR "tev_compiling.cg", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
                if (f >= 0) { sceIoWrite(f, g_diag.buf, g_diag.len); sceIoClose(f); }
                SQ_BARRIER(); g_diag.state = 3;
            }
            SqEnt *e = g_shw_abandon ? NULL : sq_take(&g_sq);
            if (!e) break;
            char fin[96]; shc_path(fin, sizeof fin, e->h, (char) e->kind);
            const SceUInt64 t0 = sceKernelGetProcessTimeWide();
            /* run 232: the pack is the store now. One append, no create + rename in a 1,300-file directory (1.6 s each, and the
               game's own reads wait behind it). No pack (NOPACK, fold off, or it failed): the per-program file, as before. */
            int ok;
            if (g_pk_on && g_pk_folded) { const unsigned b4 = rhi_vita_shc_pack_appended; shc_pk_append(e->h, (char) e->kind, (const uint32_t *) (const void *) e->img, e->len); ok = rhi_vita_shc_pack_appended != b4; }
            else ok = sq_write_image(&io, SHC_DIR "_w.tmp", fin, e->img, e->len);
            sq_finish(e, ok, (unsigned) (sceKernelGetProcessTimeWide() - t0));   /* e->img is the main thread's to free from here on */
        }
        if (g_shw_stop) break;
    }
    return 0;
}
static int shw_start(void)
{
    if (g_shw_on) return !g_shw_stopped;
    if (g_shw_failed || g_shw_stopped) return 0;
    g_shw_wake = sceKernelCreateSema("stfx_shw_w", 0, 0, 1 << 20, NULL);
    /* the same priority as every other thread of the port (asc: +32 was refused, ILLEGAL_PRIORITY) -- so it cannot be made lower than main here */
    g_shw_thr = sceKernelCreateThread("stfx_shw", shw_thread, 0x10000100, 0x20000, 0, 0, NULL);
    if (g_shw_wake < 0 || g_shw_thr < 0 || sceKernelStartThread(g_shw_thr, 0, NULL) < 0) {
        g_shw_failed = 1;
        printf("[shc] background writer NOT started (sema %08x thread %08x): saves stay synchronous\n", (unsigned) g_shw_wake, (unsigned) g_shw_thr);
        return 0;
    }
    g_shw_on = 1;
    printf("[shc] background writer ON (thread %08x)\n", (unsigned) g_shw_thr);
    return 1;
}
/* the crash sentinel: see sent_arm */
static SceUID g_sent_fd = -1; static int g_sent_broken;
#define KG_N 1024
static uint32_t g_kg[KG_N]; static unsigned g_kg_n;   /* hashes known to have linked (or loaded) in this process: no sentinel for a repeat */
static int kg_has(uint32_t h) { const unsigned n = g_kg_n < KG_N ? g_kg_n : KG_N; for (unsigned i = 0; i < n; ++i) if (g_kg[i] == h) return 1; return 0; }
static void kg_add(uint32_t h) { if (h && !kg_has(h)) g_kg[g_kg_n++ % KG_N] = h; }
/* The sentinel exists so a link that takes the process down (a Cg problem on this console can reboot it) bad-lists its
 * key at the next boot. SYNC mode: create TEV_COMPILING + tev_compiling.cg, remove the first after the link (today).
 * BACKGROUND: TEV_COMPILING is ONE file opened once and rewritten in place (8 hex digits; "00000000" = nothing in
 * flight) -- no create, no remove, no close per link; the Cg dump goes to the writer thread (best effort). Covered:
 * a process death inside glLinkProgram of a hash not seen to link before in this process (as before); NOT covered: a
 * power loss/reboot that loses the unsynced write (mode 2 syncs it), and the .cg dump of the crashing program is no
 * longer guaranteed (its first line names the key; tev_init says when it is not the sentinel's). */
static void sent_arm(uint32_t h, const char *hdrline, const char *vs, const char *fs)
{
    if (shc_bg() && kg_has(h)) { ++rhi_vita_sent_skipped; return; }   /* (not in the break arm: it keeps today's sentinel for every link) */
    /* run 230: 175 ms to arm + 161 ms to clear per new program on the main thread (the card is busy with the writer), to
       fence a 0.02 ms link: the compile itself runs on the worker behind ASC_COMPILING. Mode 1 = no main-thread sentinel;
       shc_sync.txt 2 keeps it (synced), 1 keeps the per-link files. */
    if (g_shw_mode == 1) { ++rhi_vita_sent_skipped; return; }
    const SceUInt64 t0 = sceKernelGetProcessTimeWide();
    if (shc_bg() && !g_sent_broken && shw_start()) {
        char b[9]; snprintf(b, sizeof b, "%08x", (unsigned) h);
        if (g_sent_fd < 0) g_sent_fd = sceIoOpen(TEV_DIR "TEV_COMPILING", SCE_O_RDWR | SCE_O_CREAT, 0777);
        if (g_sent_fd >= 0 && sceIoLseek(g_sent_fd, 0, SCE_SEEK_SET) == 0 && sceIoWrite(g_sent_fd, b, 8) == 8) {
            if (g_shw_mode == 2) sceIoSyncByFd(g_sent_fd, 0);
            if (g_diag.state == 3) { free(g_diag.buf); g_diag.buf = NULL; g_diag.state = 0; }
            if (g_diag.state == 0) {
                const size_t hl = strlen(hdrline), vl = strlen(vs), fl = strlen(fs);
                char *d = (char *) malloc(hl + vl + 7 + fl + 1);
                if (d) {
                    memcpy(d, hdrline, hl); memcpy(d + hl, vs, vl); memcpy(d + hl + vl, "//----\n", 7); memcpy(d + hl + vl + 7, fs, fl + 1);
                    g_diag.buf = d; g_diag.len = (unsigned) (hl + vl + 7 + fl); SQ_BARRIER(); g_diag.state = 1; ++rhi_vita_diag_queued;
                    sceKernelSignalSema(g_shw_wake, 1);
                } else ++rhi_vita_diag_skipped;
            } else ++rhi_vita_diag_skipped;   /* the writer still has the last dump: this program's is not written */
            rhi_vita_sent_arm_us += sceKernelGetProcessTimeWide() - t0;
            return;
        }
        ++rhi_vita_sent_fail; g_sent_broken = 1;
        if (g_sent_fd >= 0) { sceIoClose(g_sent_fd); g_sent_fd = -1; }
        printf("[shc] the in-place sentinel could not be written: back to the per-link files\n");
    }
    SceUID f = sceIoOpen(TEV_DIR "TEV_COMPILING", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
    if (f >= 0) { char b[16]; int n = snprintf(b, sizeof b, "%08x", (unsigned) h); sceIoWrite(f, b, (unsigned) n); sceIoClose(f); }
    /* the exact text about to be compiled, BEFORE the compile: if SceShaccCg takes the process down
       (run 89: key 7425ce77, inside glLinkProgram) this file is what it choked on */
    f = sceIoOpen(TEV_DIR "tev_compiling.cg", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
    if (f >= 0) {
        sceIoWrite(f, hdrline, (unsigned) strlen(hdrline));
        sceIoWrite(f, vs, (unsigned) strlen(vs)); sceIoWrite(f, "//----\n", 7); sceIoWrite(f, fs, (unsigned) strlen(fs));
        sceIoClose(f);
    }
    rhi_vita_sent_arm_us += sceKernelGetProcessTimeWide() - t0;
}
static void sent_clear(uint32_t h)
{
    if (g_shw_mode >= 1 && kg_has(h)) return;   /* it was not armed */
    if (g_shw_mode == 1) return;
    const SceUInt64 t0 = sceKernelGetProcessTimeWide();
    if (g_sent_fd >= 0 && !g_sent_broken) {
        if (sceIoLseek(g_sent_fd, 0, SCE_SEEK_SET) != 0 || sceIoWrite(g_sent_fd, "00000000", 8) != 8) {
            ++rhi_vita_sent_fail; g_sent_broken = 1; sceIoClose(g_sent_fd); g_sent_fd = -1; sceIoRemove(TEV_DIR "TEV_COMPILING");
        } else if (g_shw_mode == 2) sceIoSyncByFd(g_sent_fd, 0);
    } else sceIoRemove(TEV_DIR "TEV_COMPILING");
    rhi_vita_sent_clr_us += sceKernelGetProcessTimeWide() - t0;
}
static void shc_save_report(const char *why)
{
    sq_reap(&g_sq);
    const double nn = rhi_vita_shc_new_n ? (double) rhi_vita_shc_new_n : 1.0;
    printf("[shc] background saves (%s): mode %d | queued %u, written %u (writer %.1f ms each, %.0f ms max, %u KB), write failed %u | DROPPED: queue full %u, duplicate %u, abandoned at exit %u | pending %u now (%u KB of %u KB), depth max %u of %d | reloads served from the pending queue %u (%.1f ms)\n",
           why, g_shw_mode, g_sq.queued, g_sq.written, g_sq.written ? g_sq.written_us / 1000.0 / g_sq.written : 0.0, g_sq.write_us_max / 1000.0, g_sq.bytes_written / 1024u, g_sq.failed,
           g_sq.dropped_full, g_sq.dropped_dup, g_sq.abandoned, sq_pending(&g_sq), g_sq.bytes / 1024u, g_sq.max_bytes / 1024u, g_sq.depth_max, SQ_SLOTS, g_sq.served, rhi_vita_shc_qload_us / 1000.0);
    printf("[shc] main thread per NEW program (n=%u): link %.2f ms | binary-get %.2f | enqueue (length, alloc, copy) %.2f | sentinel arm %.2f + clear %.2f | synchronous save %.2f (mode 0 only) | sentinels skipped as known-good %u, failed %u | Cg dump to the writer: %u queued, %u skipped\n",
           rhi_vita_shc_new_n, rhi_vita_shc_link_us / 1000.0 / nn, rhi_vita_shc_get_us / 1000.0 / nn, rhi_vita_shc_enq_us / 1000.0 / nn,
           rhi_vita_sent_arm_us / 1000.0 / nn, rhi_vita_sent_clr_us / 1000.0 / nn, rhi_vita_shc_save_us / 1000.0 / nn,
           rhi_vita_sent_skipped, rhi_vita_sent_fail, rhi_vita_diag_queued, rhi_vita_diag_skipped);
}
/* wait (<= ms) for the writer to catch up; from any thread (the watchdog uses it). Does not stop anything. */
void rhi_vita_shc_flush(unsigned ms)
{
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_shc_flush(ms); return; }
    if (!g_shw_on) return;
    const SceUInt64 t0 = sceKernelGetProcessTimeWide();
    while ((sq_pending(&g_sq) || g_diag.state == 1) && (sceKernelGetProcessTimeWide() - t0) / 1000u < ms) sceKernelDelayThread(5000);
}
/* at exit: flush with a bounded wait, give up on what the writer has not started, ask it to stop and JOIN it (never kill) */
void rhi_vita_shc_shutdown(void)
{
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_shc_shutdown(); return; }
    if (g_shw_stopped) return;
    g_shw_stopped = 1;
    if (g_shw_on) {
        const unsigned before = sq_pending(&g_sq);
        rhi_vita_shc_flush(3000);
        g_shw_stop = 1;
        const unsigned left = sq_pending(&g_sq);
        if (left) { g_shw_abandon = 1; sq_abandon(&g_sq); }
        sceKernelSignalSema(g_shw_wake, 1);
        SceUInt to = 2000000u; const int rc = sceKernelWaitThreadEnd(g_shw_thr, NULL, &to);
        printf("[shc] exit: %u saves pending at the call, %u still unwritten after the wait (given up), writer %s (rc %08x)\n", before, left, rc >= 0 ? "joined" : "did NOT stop in 2 s (left running, not killed)", (unsigned) rc);
        if (g_diag.state == 3) { free(g_diag.buf); g_diag.buf = NULL; g_diag.state = 0; }
    }
    if (g_shw_mode >= 0) shc_save_report("final");
    if (g_sent_fd >= 0) { sceIoClose(g_sent_fd); g_sent_fd = -1; }
}
static void shc_init(void)
{
    SceUID f = sceIoOpen(TEV_DIR "NOSHC", SCE_O_RDONLY, 0777);
    if (f >= 0) { sceIoClose(f); g_shc = 0; printf("[shc] program-binary cache OFF (NOSHC marker)\n"); return; }
    g_shc = 1;
    { SceUID bf = sceIoOpen(TEV_DIR "shc_bypass.txt", SCE_O_RDONLY, 0777); char c = 0; if (bf >= 0) { sceIoRead(bf, &c, 1); sceIoClose(bf); } g_shc_bypass = c == 49;
      if (g_shc_bypass) printf("[shc] BYPASS (shc_bypass.txt 1): nothing is loaded or saved this boot, every program is compiled\n"); }
    sceIoMkdir(TEV_DIR "shc", 0777);
    f = sceIoOpen(TEV_DIR "SHC_LOADING", SCE_O_RDONLY, 0777);
    if (f >= 0) {
        char b[96] = {0}; sceIoRead(f, b, sizeof b - 1); sceIoClose(f);
        sceIoRemove(b); sceIoRemove(TEV_DIR "SHC_LOADING");
        printf("[shc] the previous boot died loading %s: deleted\n", b);
    }
    printf("[shc] program-binary cache ON (%s)\n", SHC_DIR);
}
static void shc_pk_read(void);
/* ---- THE PACK (2026-10-09, docs/47 "Run 169"): the hitches Tyler felt in gameplay are program LOADS. Runs 166-168: 422-493
 * loads a session at ~41 ms each (17.7 s cumulative), in clusters (2.7 s inside one 60-frame window). Each load opens and
 * reads its own file and creates + removes the SHC_LOADING fence: four file-system operations on the card. The pack is ONE
 * file of binaries that have each ALREADY loaded once through that fenced path, read whole at boot; a program found in it
 * links from memory with no file operation and no fence. A record that fails its checksum ends the pack there (the file is
 * deleted and refills from the per-program files). TEV_DIR "NOPACK" = no pack (A/B). 1,155 files on the card are 3.5 MB. */
#define SHC_PK_MAGIC 0x4B504853u   /* "SHPK" */
#define SHC_PK_MAX   8192
typedef struct { uint32_t h, kind, off, len; } ShcPk;   /* off / len: the file image inside g_pk_mem */
static uint32_t *g_pk_mem; static ShcPk g_pk[SHC_PK_MAX]; static unsigned g_pk_n, g_pk_dups;
/* saved once in this boot already (a program evicted and linked again must not be appended again) */
static uint32_t g_sv_h[4096]; static uint8_t g_sv_k[4096]; static unsigned g_sv_n; unsigned rhi_vita_shc_resave_skipped;
static int sv_seen(uint32_t h, char kind) { const unsigned n = g_sv_n < 4096 ? g_sv_n : 4096; for (unsigned i = 0; i < n; ++i) if (g_sv_h[i] == h && g_sv_k[i] == (uint8_t) kind) return 1;
    g_sv_h[g_sv_n % 4096] = h; g_sv_k[g_sv_n % 4096] = (uint8_t) kind; ++g_sv_n; return 0; }
static const uint32_t *shc_pk_find(uint32_t h, char kind, unsigned *len);

static unsigned g_pk_bytes, g_pk_appended_bytes;   /* the pack image held in RAM for the whole run; bytes appended to the file this boot */
unsigned rhi_vita_shc_pack_loaded, rhi_vita_shc_pack_appended, rhi_vita_shc_pack_fail;
unsigned long long rhi_vita_shc_pack_us;
static uint32_t shc_pk_sum(const uint32_t *w, unsigned nwords) { uint32_t a = 2166136261u; for (unsigned i = 0; i < nwords; ++i) a = (a ^ w[i]) * 16777619u; return a; }
static void shc_pk_read_file(void)
{
    SceUID f = sceIoOpen(TEV_DIR "NOPACK", SCE_O_RDONLY, 0777);
    if (f >= 0) { sceIoClose(f); printf("[shc] pack: OFF (NOPACK marker)\n"); return; }
    g_pk_on = 1;
    SceUInt64 t0 = sceKernelGetProcessTimeWide();
    f = sceIoOpen(SHC_DIR "pack.bin", SCE_O_RDONLY, 0777);
    if (f < 0) { printf("[shc] pack: none yet (it fills from the per-program files as they load)\n"); return; }
    long long size = sceIoLseek(f, 0, SCE_SEEK_END); sceIoLseek(f, 0, SCE_SEEK_SET);
    if (size <= 0 || size > 24 * 1024 * 1024 || !(g_pk_mem = (uint32_t *) malloc((size_t) size + 4))) { sceIoClose(f); printf("[shc] pack: %lld bytes, not read\n", size); return; }
    int n = sceIoRead(f, g_pk_mem, (unsigned) size); sceIoClose(f);
    g_pk_bytes = n > 0 ? (unsigned) n : 0u;
    unsigned o = 0, bad = 0;   /* in words */
    const unsigned nw = n > 0 ? (unsigned) n / 4u : 0u;
    while (o + 5 <= nw && g_pk_n < SHC_PK_MAX) {
        const uint32_t *r = g_pk_mem + o; const unsigned lw = (r[3] + 3u) / 4u;
        if (r[0] != SHC_PK_MAGIC || !r[3] || o + 5 + lw > nw || shc_pk_sum(r + 5, lw) != r[4]) { bad = 1; break; }
        {   int dup = 0;   /* run 233 re-saved programs it had evicted: 853 duplicate records. Indexed once. */
            for (unsigned i = 0; i < g_pk_n; ++i) if (g_pk[i].h == r[1] && g_pk[i].kind == r[2]) { dup = 1; break; }
            if (!dup) { g_pk[g_pk_n].h = r[1]; g_pk[g_pk_n].kind = r[2]; g_pk[g_pk_n].off = (o + 5) * 4u; g_pk[g_pk_n].len = r[3]; ++g_pk_n; } else ++g_pk_dups; }
        o += 5 + lw;
    }
    if (bad || o != nw) { sceIoRemove(SHC_DIR "pack.bin"); printf("[shc] pack: a bad record at byte %u of %d -- %u records kept for this boot, the file deleted (it refills)\n", o * 4u, n, g_pk_n); }
    printf("[shc] pack: %u programs, %d bytes, read in %.1f ms\n", g_pk_n, n, (double) (sceKernelGetProcessTimeWide() - t0) / 1000.0);
}
static const uint32_t *shc_pk_find(uint32_t h, char kind, unsigned *len)
{
    for (unsigned i = 0; i < g_pk_n; ++i) if (g_pk[i].h == h && g_pk[i].kind == (uint32_t) kind) { *len = g_pk[i].len; return (const uint32_t *) ((const uint8_t *) g_pk_mem + g_pk[i].off); }
    return NULL;
}
/* a file image that has just loaded and linked: append it, so the next boot finds it in the pack */
static void shc_pk_append(uint32_t h, char kind, const uint32_t *img, unsigned len)
{
    if (!g_pk_on) return;
    static volatile int lock;   /* the main thread and the writer both append */
    while (__sync_lock_test_and_set(&lock, 1)) sceKernelDelayThread(1000);
    const unsigned lw = (len + 3u) / 4u;
    uint32_t hd[5] = { SHC_PK_MAGIC, h, (uint32_t) kind, len, shc_pk_sum(img, lw) };
    SceUID f = sceIoOpen(SHC_DIR "pack.bin", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_APPEND, 0777);
    if (f < 0) { ++rhi_vita_shc_pack_fail; __sync_lock_release(&lock); return; }
    int w = sceIoWrite(f, hd, sizeof hd); w += sceIoWrite(f, img, lw * 4u); sceIoClose(f);
    if (w != (int) (sizeof hd + lw * 4u)) { ++rhi_vita_shc_pack_fail; sceIoRemove(SHC_DIR "pack.bin"); g_pk_on = 0; __sync_lock_release(&lock); return; }
    ++rhi_vita_shc_pack_appended; g_pk_appended_bytes += (unsigned) w;
    __sync_lock_release(&lock);
}
/* Run 232: a program not in the pack cost the main thread one sceIoOpen in a 1,300-file directory, on a card the writer
 * is busy on -- for a file that mostly does not exist (a NEW program), before any timer starts: frames of 1.2-3.2 s with
 * no shader time in them. And 57 files that did exist took 8.0 s. So at boot, once: every per-program file that is not in
 * the pack goes into it, and from then on the main thread opens no per-program file at all (g_pk_folded).
 * ux0:data/STFX00001/shc_fold_off.txt starting with 1 = no fold (the break arm: as run 231). */
unsigned rhi_vita_shc_folded, rhi_vita_shc_fold_seen;
static unsigned shc_pk_fold(void)
{
    if (!g_pk_on) return 0;
    const SceUInt64 t0 = sceKernelGetProcessTimeWide();
    SceUID d = sceIoDopen(TEV_DIR "shc");
    if (d < 0) { printf("[shc] fold: the directory did not open (%08x): per-program files stay on the main thread\n", (unsigned) d); return 0; }
    unsigned added = 0, bad = 0; SceIoDirent de;
    for (;;) {
        memset(&de, 0, sizeof de);
        if (sceIoDread(d, &de) <= 0) break;
        const char *nm = de.d_name; unsigned h = 0; const char kind = nm[0];
        if (strlen(nm) != 13 || strcmp(nm + 9, ".bin") || !strchr("tfgh", kind)) continue;
        int okhex = 1;
        for (int i = 1; i < 9; ++i) { const char c = nm[i]; const int v = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1; if (v < 0) { okhex = 0; break; } h = (h << 4) | (unsigned) v; }
        if (!okhex) continue;
        ++rhi_vita_shc_fold_seen;
        unsigned pl = 0; if (shc_pk_find(h, kind, &pl)) continue;
        char path[96]; snprintf(path, sizeof path, SHC_DIR "%s", nm);
        SceUID f = sceIoOpen(path, SCE_O_RDONLY, 0777);
        if (f < 0) continue;
        const int n = sceIoRead(f, g_shc_buf, sizeof g_shc_buf - 4); sceIoClose(f);
        if (n < 32 || g_shc_buf[0] != SHC_MAGIC || g_shc_buf[1] != SHC_VERSION || (unsigned) n != 16u + ((g_shc_buf[2] + 3u) & ~3u) + g_shc_buf[3]) { ++bad; continue; }
        if (n & 3) memset((uint8_t *) g_shc_buf + n, 0, 4 - (n & 3));
        const unsigned before = rhi_vita_shc_pack_appended;
        shc_pk_append(h, kind, g_shc_buf, (unsigned) n);
        if (rhi_vita_shc_pack_appended != before) ++added; else break;   /* the pack could not be written: stop */
    }
    sceIoDclose(d);
    g_pk_folded = g_pk_on;
    rhi_vita_shc_folded = added;
    printf("[shc] pack index: %u programs, %u duplicate records skipped\n", g_pk_n, g_pk_dups);
    printf("[shc] fold: %u per-program files seen, %u not in the pack and appended to it, %u stale or malformed (left alone), in %.1f ms | the main thread opens no per-program file from here: %s\n",
           rhi_vita_shc_fold_seen, added, bad, (double) (sceKernelGetProcessTimeWide() - t0) / 1000.0, g_pk_folded ? "yes" : "NO");
    return added;
}
static void shc_pk_read(void)
{
    shc_pk_read_file();
    { SceUID nf = sceIoOpen(TEV_DIR "shc_fold_off.txt", SCE_O_RDONLY, 0777); char c = 0; if (nf >= 0) { sceIoRead(nf, &c, 1); sceIoClose(nf); }
      if (c == 49) { printf("[shc] fold OFF (shc_fold_off.txt 1): per-program files load on the main thread, as run 231\n"); return; } }
    if (shc_pk_fold()) { free(g_pk_mem); g_pk_mem = NULL; g_pk_n = 0; g_pk_bytes = 0; shc_pk_read_file(); }
}
static void shc_path(char *out, size_t cap, uint32_t h, char kind) { snprintf(out, cap, SHC_DIR "%c%08x.bin", kind, (unsigned) h); }
/* the linked program, or 0 (no file, stale, or it did not link) */
static GLuint shc_load(uint32_t h, char kind, const void *k1, unsigned n1, const void *k2, unsigned n2)
{
    if (g_shc < 0) { shc_init(); if (g_shc) shc_pk_read(); }
    if (!g_shc || g_shc_bypass) return 0;
    const unsigned klen = (n1 + n2 + 3u) & ~3u, hdr = 16u + klen;
    {   /* the pack first: memory only, no file operation, no fence (every record in it has loaded through the fence before) */
        unsigned plen = 0; const uint32_t *im = shc_pk_find(h, kind, &plen);
        if (im && shc_image_valid((const uint8_t *) im, plen, SHC_MAGIC, SHC_VERSION, k1, n1, k2, n2)) {
            SceUInt64 p0 = sceKernelGetProcessTimeWide();
            GLuint pp = pl_create_program();
            if (!pp) return 0;
            glProgramBinary(pp, 0, (const uint8_t *) im + hdr, (GLsizei) im[3]);
            GLint ok = 0; glGetProgramiv(pp, GL_LINK_STATUS, &ok);
            rhi_vita_shc_pack_us += sceKernelGetProcessTimeWide() - p0;
            if (ok) { ++rhi_vita_shc_pack_loaded; kg_add(h); return pp; }
            ++rhi_vita_shc_pack_fail;   /* falls through to the per-program file */
            glDeleteProgram(pp); ++rhi_vita_prog_leak_fixed;   /* run 224: the handle and its two shader objects were left allocated */
        }
    }
    if (g_shw_mode >= 1) {   /* a save that has not reached the card yet (queued, being written, or written and not yet reaped): link from its bytes */
        sq_reap(&g_sq);
        const SqEnt *qe = sq_find_valid(&g_sq, h, (uint32_t) kind, SHC_MAGIC, SHC_VERSION, k1, n1, k2, n2);
        if (qe) {
            GLuint qp = pl_create_program();
            if (!qp) return 0;
            const SceUInt64 q0 = sceKernelGetProcessTimeWide();
            glProgramBinary(qp, 0, qe->img + hdr, (GLsizei) ((const uint32_t *) qe->img)[3]);
            GLint qok = 0; glGetProgramiv(qp, GL_LINK_STATUS, &qok);
            rhi_vita_shc_qload_us += sceKernelGetProcessTimeWide() - q0;
            if (qok) { kg_add(h); return qp; }
            ++rhi_vita_shc_load_fail; glDeleteProgram(qp); ++rhi_vita_prog_leak_fixed;
            return 0;
        }
    }
    if (g_pk_folded) return 0;   /* everything on the card is in the pack: no directory lookup on the main thread */
    char path[96]; shc_path(path, sizeof path, h, kind);
    SceUID f = sceIoOpen(path, SCE_O_RDONLY, 0777);
    if (f < 0) return 0;
    SceUInt64 t0 = sceKernelGetProcessTimeWide();
    int n = sceIoRead(f, g_shc_buf, sizeof g_shc_buf); sceIoClose(f);
    if (n < (int) hdr + 16 || !shc_image_valid((const uint8_t *) g_shc_buf, (unsigned) n, SHC_MAGIC, SHC_VERSION, k1, n1, k2, n2)) { ++rhi_vita_shc_stale; return 0; }
    GLuint pr = pl_create_program();   /* before the fence: a refused handle must not leave SHC_LOADING behind (the next boot would delete a good file) */
    if (!pr) return 0;
    f = sceIoOpen(TEV_DIR "SHC_LOADING", SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
    if (f >= 0) { sceIoWrite(f, path, (unsigned) strlen(path)); sceIoClose(f); }
    glProgramBinary(pr, 0, (const uint8_t *) g_shc_buf + hdr, (GLsizei) g_shc_buf[3]);
    sceIoRemove(TEV_DIR "SHC_LOADING");
    GLint linked = 0; glGetProgramiv(pr, GL_LINK_STATUS, &linked);
    rhi_vita_shc_load_us += sceKernelGetProcessTimeWide() - t0;
    if (!linked) { ++rhi_vita_shc_load_fail; sceIoRemove(path); glDeleteProgram(pr); ++rhi_vita_prog_leak_fixed; return 0; }
    ++rhi_vita_shc_loaded; kg_add(h);
    shc_pk_append(h, kind, g_shc_buf, (unsigned) n);
    return pr;
}
static void shc_save_sync(uint32_t h, char kind, const void *k1, unsigned n1, const void *k2, unsigned n2, GLuint prog)
{
    SceUInt64 t0 = sceKernelGetProcessTimeWide();
    const unsigned klen = (n1 + n2 + 3u) & ~3u, hdr = 16u + klen;
    GLint want = 0; glGetProgramiv(prog, GL_PROGRAM_BINARY_LENGTH, &want);
    /* vitaGL's glGetProgramBinary does not check bufSize: refuse on the reported length, before it writes */
    if (want <= 0 || (unsigned) want + hdr > sizeof g_shc_buf) { ++rhi_vita_shc_save_fail; return; }
    memset(g_shc_buf, 0, hdr);
    GLsizei len = 0; GLenum fmt = 0;
    glGetProgramBinary(prog, (GLsizei) (sizeof g_shc_buf - hdr), &len, &fmt, (uint8_t *) g_shc_buf + hdr);
    if (len <= 0 || (unsigned) len + hdr > sizeof g_shc_buf) { ++rhi_vita_shc_save_fail; return; }
    g_shc_buf[0] = SHC_MAGIC; g_shc_buf[1] = SHC_VERSION; g_shc_buf[2] = n1 + n2; g_shc_buf[3] = (uint32_t) len;
    memcpy((uint8_t *) &g_shc_buf[4], k1, n1); if (n2) memcpy((uint8_t *) &g_shc_buf[4] + n1, k2, n2);
    char path[96]; shc_path(path, sizeof path, h, kind);
    SceUID f = sceIoOpen(path, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
    if (f < 0) { ++rhi_vita_shc_save_fail; return; }
    int w = sceIoWrite(f, g_shc_buf, hdr + (unsigned) len); sceIoClose(f);
    if (w != (int) (hdr + (unsigned) len)) { ++rhi_vita_shc_save_fail; sceIoRemove(path); return; }
    ++rhi_vita_shc_saved;
    rhi_vita_shc_save_us += sceKernelGetProcessTimeWide() - t0;
}
/* The save. Main-thread work: the length query, one malloc, glGetProgramBinary straight into the image (it must run on the GL
 * thread), the header, one enqueue. The card is the writer's. A full queue DROPS the save (counted): the program works this boot. */
static void shc_save(uint32_t h, char kind, const void *k1, unsigned n1, const void *k2, unsigned n2, GLuint prog)
{
    if (g_shc < 0) { shc_init(); if (g_shc) shc_pk_read(); }
    if (!g_shc || g_shc_bypass) return;
    { unsigned pl = 0; if (g_pk_folded && (shc_pk_find(h, kind, &pl) || sv_seen(h, kind))) { ++rhi_vita_shc_resave_skipped; return; } }
    if (!shc_bg() || !shw_start()) {
        if (g_shw_stopped) { sq_drop(&g_sq); return; }   /* at exit: no new card work */
        shc_save_sync(h, kind, k1, n1, k2, n2, prog); return;
    }
    const SceUInt64 t0 = sceKernelGetProcessTimeWide();
    sq_reap(&g_sq);
    const unsigned klen = (n1 + n2 + 3u) & ~3u, hdr = 16u + klen;
    GLint want = 0; glGetProgramiv(prog, GL_PROGRAM_BINARY_LENGTH, &want);
    if (want <= 0 || (unsigned) want + hdr > sizeof g_shc_buf) { ++rhi_vita_shc_save_fail; return; }   /* vitaGL does not check bufSize: refuse on the reported length */
    if (sq_room(&g_sq, hdr + (unsigned) want)) { sq_drop(&g_sq); return; }   /* before the binary is fetched: a dropped save costs nothing more */
    uint8_t *img = (uint8_t *) malloc(hdr + (unsigned) want);
    if (!img) { ++rhi_vita_shc_save_fail; return; }
    memset(img, 0, hdr);
    const SceUInt64 t1 = sceKernelGetProcessTimeWide();
    GLsizei len = 0; GLenum fmt = 0;
    glGetProgramBinary(prog, (GLsizei) want, &len, &fmt, img + hdr);
    const SceUInt64 t2 = sceKernelGetProcessTimeWide();
    if (len <= 0 || len > want) { free(img); ++rhi_vita_shc_save_fail; return; }
    uint32_t *w = (uint32_t *) img;
    w[0] = SHC_MAGIC; w[1] = SHC_VERSION; w[2] = n1 + n2; w[3] = (uint32_t) len;
    memcpy(img + 16, k1, n1); if (n2) memcpy(img + 16 + n1, k2, n2);
    if (sq_enqueue(&g_sq, h, (uint32_t) kind, img, hdr + (unsigned) len) < 0) free(img);   /* refused: still ours */
    else sceKernelSignalSema(g_shw_wake, 1);
    rhi_vita_shc_get_us += t2 - t1;
    rhi_vita_shc_enq_us += (t1 - t0) + (sceKernelGetProcessTimeWide() - t2);
}
