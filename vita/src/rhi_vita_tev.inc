    if (g->tk.ik.on) {   /* indirect texturing: the matrices and the sizes of the textures it samples through an offset */
        float sz[TEVK_TEX][2]; memset(sz, 0, sizeof sz);
        for (int t = 0; t < tk->numTex; ++t) { sz[t][0] = (float) ((VitaTexture *) tex[t])->w; sz[t][1] = (float) ((VitaTexture *) tex[t])->h; }
        ind_upload(&g->tk, g->uIM, g->uTS, u, sz);
    }
    if (tk->fogType) {
        glUniform4f(g->uFog, u->fogStart, u->fogScale, 0.0f, 0.0f);
        glUniform4f(g->uFogColor, u->fogColor[0] / 255.0f, u->fogColor[1] / 255.0f, u->fogColor[2] / 255.0f, 0.0f);
    }
    for (int t = 0; t < tk->numTex; ++t) {
        glActiveTexture(GL_TEXTURE0 + t);
        glBindTexture(GL_TEXTURE_2D, ids[t]);
    }
    glBindBuffer(GL_ARRAY_BUFFER, m->vbo);
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, m->ibo);
    int na = 4;
    glEnableVertexAttribArray(0); glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offPos);
    if (vk->hasNrm)    { glEnableVertexAttribArray(1); glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offNrm); }
    if (vk->hasClr0)   { glEnableVertexAttribArray(2); glVertexAttribPointer(2, 4, GL_UNSIGNED_BYTE, GL_TRUE, L->stride, (const void *) (size_t) L->offClr); }
    if (vk->hasMtxIdx) { glEnableVertexAttribArray(3); glVertexAttribPointer(3, 1, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offMtx); }
    for (int n = 0; n < 8; ++n) if (vk->texMask >> n & 1) {
        glEnableVertexAttribArray((GLuint) na);
        glVertexAttribPointer((GLuint) na, 2, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offTex[n]);
        ++na;
    }
    if (vk->hasBin) { glEnableVertexAttribArray((GLuint) na); glVertexAttribPointer((GLuint) na, 3, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offBin); ++na; }
    if (vk->hasTan) { glEnableVertexAttribArray((GLuint) na); glVertexAttribPointer((GLuint) na, 3, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offTan); ++na; }
    { const unsigned tg = tev_vs_tmi_groups(vk);
      for (int q = 0; q < 2; ++q) if (tg >> q & 1) { glEnableVertexAttribArray((GLuint) na); glVertexAttribPointer((GLuint) na, 4, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offTmi[q]); ++na; } }
    if (vk->hasSkin) {   /* R8: aSkP / aSkN, F32x4 holding the integers 0..255 */
        glEnableVertexAttribArray((GLuint) na); glVertexAttribPointer((GLuint) na, 4, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) L->offSk); ++na;
        if (vk->hasNrm) { glEnableVertexAttribArray((GLuint) na); glVertexAttribPointer((GLuint) na, 4, GL_FLOAT, GL_FALSE, L->stride, (const void *) (size_t) (L->offSk + 16)); ++na; }
    }
    SceUInt64 d1 = sceKernelGetProcessTimeWide();
    if (AB_ARM != 2) glDrawElements(GL_TRIANGLES, (GLsizei) m->nidx, GL_UNSIGNED_SHORT, (const void *) 0);
    rhi_vita_gx_gldraw_us += sceKernelGetProcessTimeWide() - d1;
    for (int a = 0; a < na; ++a) glDisableVertexAttribArray((GLuint) a);
    glBindBuffer(GL_ARRAY_BUFFER, 0);
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
    glUseProgram(0);
    glActiveTexture(GL_TEXTURE0);
    gs_cur.backend_draws++; gs_cur.tex_calls++; gs_cur.tex_tris += m->nidx / 3u;
    ++rhi_vita_gx_draws;
    rhi_vita_gx_draw_us += sceKernelGetProcessTimeWide() - d0;
    return 1;
}
#undef sceKernelGetProcessTimeWide   /* GXAOT_HOOK C3 arm 106 */
/* ==== MEMORY + BUDGET TELEMETRY (2026-10-11, run 224: the crash left a truncated dump and no number about memory) ====
 * One line, [mem], with everything that can run out: vitaGL's pools, the newlib heap, what the kernel still has, the shader
 * patcher's three fixed 1 MB areas (vitaGL's defaults: this port never calls vglSetupShaderPatcher), vitaGL's program and
 * shader handles, the meshes and textures alive, the pack. It is printed in the status block, at every 50th program build,
 * and -- with [mem] LOW and an immediate write to the card -- when the check that runs every 60 presents finds something
 * under its threshold. All of it is counters and four cheap calls; nothing here walks a heap. */
#include <psp2/kernel/sysmem.h>
#include <psp2/gxm.h>
extern SceGxmShaderPatcher *gxm_shader_patcher;   /* vitaGL gxm.c */
extern unsigned int _newlib_heap_size_user;
/* rhi_vita_textures_alive / rhi_vita_texture_bytes: rhi_vita.c, vita_createTexture / vita_destroyTexture (this file is included at its end) */
/* the patcher's areas: g_patcher_kb[] (rhi_vita.c: buffer, vertex USSE, fragment USSE; 1024 / 2048 / 1024 KB unless patcher_small.txt) */
typedef struct { unsigned vglFree[4], vglTotal[4], heapCap, heapArena, heapUsed, kUser, kCdram, kPhycont, spHost, spBuf, spVert, spFrag; } PlMem;
static void pl_mem_read(PlMem *m)
{
    static const vglMemType kT[4] = { VGL_MEM_VRAM, VGL_MEM_RAM, VGL_MEM_PHYCONT, VGL_MEM_BUDGET };
    memset(m, 0, sizeof *m);
    for (int i = 0; i < 4; ++i) { m->vglFree[i] = (unsigned) (vglMemFree(kT[i]) / 1024u); m->vglTotal[i] = (unsigned) (vglMemTotal(kT[i]) / 1024u); }
    struct mallinfo mi = mallinfo();
    m->heapCap = _newlib_heap_size_user / 1024u; m->heapArena = (unsigned) mi.arena / 1024u; m->heapUsed = (unsigned) mi.uordblks / 1024u;
    SceKernelFreeMemorySizeInfo fi; memset(&fi, 0, sizeof fi); fi.size = sizeof fi;
    /* (run 226 printed "user 4193280": the kernel's figure is a SIGNED int and had gone a little below zero; clamped, not wrapped) */
    if (sceKernelGetFreeMemorySize(&fi) >= 0) { m->kUser = fi.size_user > 0 ? (unsigned) fi.size_user / 1024u : 0u; m->kCdram = fi.size_cdram > 0 ? (unsigned) fi.size_cdram / 1024u : 0u; m->kPhycont = fi.size_phycont > 0 ? (unsigned) fi.size_phycont / 1024u : 0u; }
    if (gxm_shader_patcher) {
        m->spHost = sceGxmShaderPatcherGetHostMemAllocated(gxm_shader_patcher) / 1024u;
        m->spBuf  = sceGxmShaderPatcherGetBufferMemAllocated(gxm_shader_patcher) / 1024u;
        m->spVert = sceGxmShaderPatcherGetVertexUsseMemAllocated(gxm_shader_patcher) / 1024u;
        m->spFrag = sceGxmShaderPatcherGetFragmentUsseMemAllocated(gxm_shader_patcher) / 1024u;
    }
}
static void pl_mem_print(const char *why, const PlMem *m)
{
    printf("[mem] %s (present %d) | vitaGL pools free/total KB: cdram %u/%u ram %u/%u phycont %u/%u cdlg %u/%u | newlib heap KB: in use %u, taken from the system %u, of %u | kernel free KB: user %u cdram %u phycont %u"
           " | shader patcher KB: host %u, buffer %u/%u, vertex USSE %u/%u, fragment USSE %u/%u | GL programs %d live of budget %d (vitaGL %d; TEV %d, pair %d; peak %d), shader handles %d + %d shared of %d"
           " | meshes %u (%u KB) textures %u (%u KB) | pack %u records %u KB in RAM\n",
           why, rhi_vita_presents, m->vglFree[0], m->vglTotal[0], m->vglFree[1], m->vglTotal[1], m->vglFree[2], m->vglTotal[2], m->vglFree[3], m->vglTotal[3],
           m->heapUsed, m->heapArena, m->heapCap, m->kUser, m->kCdram, m->kPhycont,
           m->spHost, m->spBuf, g_patcher_kb[0], m->spVert, g_patcher_kb[1], m->spFrag, g_patcher_kb[2],
           g_plru.live, g_plru.hard, PL_VGL_PROGS, g_plru.tlive[0], g_plru.tlive[1], g_plru.peak, g_plru.sec_used, g_shobj_n, PL_VGL_SHADERS,
           rhi_vita_gx_meshes, (unsigned) (rhi_vita_gx_mesh_bytes / 1024u), rhi_vita_textures_alive, (unsigned) (rhi_vita_texture_bytes / 1024u),
           g_pk_n, g_pk_bytes / 1024u);
}
static void pl_mem_line(const char *why) { PlMem m; pl_mem_read(&m); pl_mem_print(why, &m); }
/* THE LOW-MEMORY GUARD: every 60 presents. A bit per resource under its threshold; the line is printed (and written to the
 * card at once) when the set changes, and again every 600 presents while anything is low. */
unsigned rhi_vita_mem_low_events;
#define PL_LOW_HEAP_KB   3072u   /* newlib: less than 3 MB of the heap left */
#define PL_LOW_POOL_KB   2048u   /* a vitaGL pool, or the kernel's own free user / cdram memory: under 2 MB */
#define PL_LOW_PATCHER(used, area) ((used) > g_patcher_kb[area] - g_patcher_kb[area] / 8u)   /* a shader-patcher area over 7/8 full */
static void pl_low_check(void)
{
    static unsigned s_last; static int s_at = -100000;
    PlMem m; pl_mem_read(&m);
    unsigned low = 0;
    if (m.heapCap - m.heapUsed < PL_LOW_HEAP_KB) low |= 1u;
    if (m.vglTotal[0] && m.vglFree[0] < PL_LOW_POOL_KB) low |= 2u;
    if (m.vglTotal[1] && m.vglFree[1] < PL_LOW_POOL_KB) low |= 4u;
    if (PL_LOW_PATCHER(m.spBuf, 0)) low |= 8u;
    if (PL_LOW_PATCHER(m.spVert, 1)) low |= 16u;
    if (PL_LOW_PATCHER(m.spFrag, 2)) low |= 32u;
    if (g_plru.live > g_plru.hard - 16) low |= 64u;
    if (g_plru.sec_used + g_shobj_n > g_plru.sec_cap - 32) low |= 128u;
    if (!low) { s_last = 0; return; }
    if (low == s_last && rhi_vita_presents - s_at < 600) return;
    s_last = low; s_at = rhi_vita_presents; ++rhi_vita_mem_low_events;
    printf("[mem] LOW (event %u):%s%s%s%s%s%s%s%s\n", rhi_vita_mem_low_events,
           low & 1u ? " newlib heap under 3 MB;" : "", low & 2u ? " vitaGL cdram pool under 2 MB;" : "", low & 4u ? " vitaGL ram pool under 2 MB;" : "",
           low & 8u ? " shader patcher buffer over 7/8;" : "", low & 16u ? " shader patcher VERTEX USSE over 7/8;" : "", low & 32u ? " shader patcher FRAGMENT USSE over 7/8;" : "",
           low & 64u ? " GL programs within 16 of the budget;" : "", low & 128u ? " shader handles within 32 of vitaGL's table;" : "");
    pl_mem_print("LOW", &m);
    pl_log_now();
}
/* prog_probe.txt starting with 1: how many programs vitaGL hands out before it runs dry, and what it answers then -- on the
 * console, in a second, with nothing at stake (empty programs, deleted again). Run 224's mechanism, watched instead of read. */
static void pl_probe(void)
{
    if (pl_file_int("ux0:data/stairfax/prog_probe.txt", 0) != 1) return;
    static GLuint ids[PL_VGL_PROGS + 8]; int n = 0; GLuint last = 0;
    while (n < PL_VGL_PROGS + 8) { last = glCreateProgram(); if (last == 0 || last > PL_VGL_PROGS) break; ids[n++] = last; }
    for (int i = 0; i < n; ++i) glDeleteProgram(ids[i]);
    printf("[plru] probe (prog_probe.txt): vitaGL gave %d more program handles with %d already live in the tables, then answered %08x (highest handle %u) -- all %d deleted again\n",
           n, g_plru.live, (unsigned) last, n ? (unsigned) ids[n - 1] : 0u, n);
    pl_log_now();
}
unsigned rhi_vita_trim_count, rhi_vita_trim_patcher;   /* programs the per-present trim took: for the counts / for a patcher area over 3/4 */
static void pl_tick(void)
{
    static int s_probed;
    if (g_pl_state < 0) pl_init();
    if (!s_probed && rhi_vita_presents >= 30) { s_probed = 1; pl_probe(); }
    /* The trim (see pl_init): ONE program a present, idle for prog_idle presents, none after a present that built one. Its two
       triggers: the counts over their marks (64 under the budget), or a shader-patcher USSE area over 3/4 -- two calls into
       sceGxm a present, and the reason is counted so the next log says which of the two is doing the evicting. */
    int pressure = 0, severe = 0;
    if (gxm_shader_patcher) {
        const unsigned v = sceGxmShaderPatcherGetVertexUsseMemAllocated(gxm_shader_patcher) / 1024u, f = sceGxmShaderPatcherGetFragmentUsseMemAllocated(gxm_shader_patcher) / 1024u;
        pressure = v > g_patcher_kb[1] / 4u * 3u || f > g_patcher_kb[2] / 4u * 3u;
        severe = PL_LOW_PATCHER(v, 1) || PL_LOW_PATCHER(f, 2);   /* over 7/8: vitaGL does not check the patcher, so past the end is a crash -- a program idle for 2 s goes, not 1800 presents */
    }
    const int over = g_plru.live > g_plru.soft || g_plru.sec_used + pl_sec_extra() > g_plru.sec_soft;
    const int idle = g_plru.min_age;
    if (severe && idle > 120) g_plru.min_age = 120;
    const int n = plru_tick(&g_plru, pl_sec_extra(), rhi_vita_presents, 1, pressure);
    g_plru.min_age = idle;
    if (n) { if (over) rhi_vita_trim_count += (unsigned) n; else rhi_vita_trim_patcher += (unsigned) n; }
    if (rhi_vita_presents % 60 == 0) pl_low_check();
}
void rhi_vita_gx_report(void)   /* vt_game.c's status block */
{
    if (g_stfx_backend == STFX_BK_GXM) { rhi_gxm_gx_report(); return; }
    if (g_pl_state < 0) pl_init();
    printf("[plru] budget %d live programs (trim from %d), eviction %s | live %d (TEV %d of %d slots used, pair %d of %d), peak %d | evicted %u (%.1f ms cumulative in glDeleteProgram), reloaded after eviction %u, slots recycled %u"
           " | REFUSED for want of room: budget %u, shader objects %u, TEV table %u, pair table %u | vitaGL handed back no handle %u | handles returned on failed links %u | low-memory events %u"
           " | trim: %u for the counts, %u for a patcher area over 3/4, %u ticks put off after a build\n",
           g_plru.hard, g_plru.soft, g_plru.on ? "on" : "OFF (prog_evict.txt 1)", g_plru.live, g_plru.tlive[0], g_tevp_n, g_plru.tlive[1], g_gxp_n, g_plru.peak,
           g_plru.evictions, rhi_vita_prog_destroy_us / 1000.0, g_plru.reloads, g_plru.recycled,
           g_plru.refused, rhi_vita_shobj_refused, rhi_vita_tev_table_full, rhi_vita_gx_table_full, rhi_vita_prog_handle_fail, rhi_vita_prog_leak_fixed, rhi_vita_mem_low_events,
           rhi_vita_trim_count, rhi_vita_trim_patcher, g_plru.tick_deferred);
    {   int depth = 0; for (int i = 0; i < ASC_MAX; ++i) depth += g_asc[i].state != ASC_FREE;
        /* the stack figure is the worker's own scan of the kernel's fill (asc_stack_scan): run 226's "7848 KB never used of 2048"
           was sceKernelGetThreadStackFreeSize, which is not that quantity */
        if (g_asc_stack_used >= 0) printf("[asc] queue: %d of %d now, %u at most | worker stack: %d KB used at most of %d (its own scan of the fill pattern, after %u compiles)\n",
                                          depth, ASC_MAX, rhi_vita_asc_depth_max, (g_asc_stack_used + 1023) / 1024, ASC_STACK_BYTES / 1024, g_asc_stack_scans);
        else printf("[asc] queue: %d of %d now, %u at most | worker stack: UNKNOWN (%s)\n", depth, ASC_MAX, rhi_vita_asc_depth_max,
                    g_asc_stack_used == -2 ? "the stack is not filled with ffffffff where this build expects it: no figure is better than a wrong one" : "no compile has run yet");
        printf("[asc] crash sentinel %s | sources never compiled again (killed the worker %d times or more): %u, programs refused for them %u | strikes on file %u\n",
               g_ascs_fd >= 0 ? "armed" : g_ascs_off ? "OFF (asc_sentinel.txt 1)" : "NOT armed", g_ascs_strikes_bad, g_ascs_bad_n, rhi_vita_asc_bad_refused, g_ascs_n); }
    pl_mem_line("status");
    printf("[tev] fast-variant programs built or loaded: %u\n", rhi_vita_tev_fast_programs);
    printf("[shobj] shader objects: %u compiled (%.1f ms cumulative, %.0f ms each), %u reused by a later program\n", rhi_vita_shobj_compiles,
           rhi_vita_shobj_compile_us / 1000.0, rhi_vita_shobj_compiles ? rhi_vita_shobj_compile_us / 1000.0 / rhi_vita_shobj_compiles : 0.0, rhi_vita_shobj_reuses);
    printf("[shc] program-binary cache %s | loaded %u (%.1f ms cumulative), saved %u (%.1f ms), stale %u, load failed %u, save failed %u\n",
           g_shc > 0 ? "ON" : g_shc == 0 ? "OFF" : "unused", rhi_vita_shc_loaded, rhi_vita_shc_load_us / 1000.0, rhi_vita_shc_saved,
           rhi_vita_shc_save_us / 1000.0, rhi_vita_shc_stale, rhi_vita_shc_load_fail, rhi_vita_shc_save_fail);
    if (g_shw_mode >= 0) shc_save_report("status");
    printf("[asc] compiles off the main thread %s: %u queued, %u picked up (%.1f s of compiling kept off the frame), %u failed | programs deferred %u, draws skipped while pending %u | main-thread waits %u, results discarded %u, queue full %u\n",
           g_asc_on > 0 ? "ON" : "off", rhi_vita_asc_jobs, rhi_vita_asc_picked, (double) rhi_vita_asc_ms / 1000.0, rhi_vita_asc_failed, rhi_vita_asc_deferred, rhi_vita_asc_skipped_draws,
           rhi_vita_asc_main_waits, rhi_vita_asc_discarded, rhi_vita_asc_queue_full);
    printf("[shc] pack %s: %u programs in it at boot | linked from it %u (%.1f ms cumulative, %.1f ms each) | appended this boot %u | failures %u\n",
           g_pk_on ? "ON" : "off", g_pk_n, rhi_vita_shc_pack_loaded, rhi_vita_shc_pack_us / 1000.0,
           rhi_vita_shc_pack_loaded ? rhi_vita_shc_pack_us / 1000.0 / rhi_vita_shc_pack_loaded : 0.0, rhi_vita_shc_pack_appended, rhi_vita_shc_pack_fail);
    printf("[gxp] programs %u of %d (link fail %u, bad-list %u, refused %u, table full %u), compile %.1f ms cumulative | draws %u, %.1f ms cumulative (glDrawElements alone %.1f) | meshes %u\n",
