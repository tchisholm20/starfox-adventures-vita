        if (nw_ < (GXT_W(t) + GXT_W(nb)) || nw_ - (GXT_W(t) + GXT_W(nb)) > 384u) return -1;
        const uint32_t *q_ = p_;
        GXT_GET(q_, t);
        GXT_GET(q_, nb);
        if (nw_ - (GXT_W(t) + GXT_W(nb)) != GXT_WORDS((nb*48))) return -1;
        memcpy(sc_, q_, (size_t)(nw_ - (GXT_W(t) + GXT_W(nb))) * 4u);
        __real_GXStfxSkinBind(t, (void *) sc_, nb);
