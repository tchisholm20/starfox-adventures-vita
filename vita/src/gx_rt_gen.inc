    if (GXT_FLT_WANTS(GXT_OP_GXCallDisplayList) && nw_ <= GXT_FLT_PRE_MAXW) {
        uint32_t w_[GXT_FLT_PRE_MAXW], *p_ = w_;
        GXT_PUT(p_, list);
        GXT_PUT(p_, nbytes);
        if (gxt_flt_check(GXT_OP_GXCallDisplayList, w_, nw_)) return;
        q_ = gxt_rec_alloc_flt(GXT_OP_GXCallDisplayList, nw_);
        memcpy(q_, w_, (size_t) nw_ * 4u);
